{"admitted_at_utc":"2026-10-08T06:58:46.482380Z","arguments":{"source":"import odoolib,json\nc=odoolib.get_connection(hostname='127.0.0.1',protocol='json2',port=8069,database='bench',password=open('/etc/odoo/api_key').read().strip())\ndef q(m,d,f): return c.get_model(m).search_read(domain=d,fields=f,limit=1000)\nprint('SELECT_VENDORS',json.dumps(q('res.partner',[('id','in',[6,7,8,9,10])],['id','name','comment']),default=str))\nprint('FINISHED_EXISTING_LINES',json.dumps(q('purchase.order.line',[('order_id','in',[19,20,21])],['id','order_id','product_id','product_qty','price_unit','date_planned']),default=str))\nprint('COMPONENT_STOCK',json.dumps(q('product.product',[('id','in',[3,4,5,6,7])],['id','name','qty_available','free_qty']),default=str))\nprint('ALL_COMPONENT_PO_LINES',json.dumps(q('purchase.order.line',[('order_id','<=',18)],['id','order_id','product_id','product_qty','price_unit','date_planned']),default=str))\nprint('MO_RAW_MOVES',json.dumps(q('stock.move',[('raw_material_production_id','in',[1,2,3,4,5])],['id','raw_material_production_id','product_id','product_uom_qty','state','purchase_line_id']),default=str))\nprint('MO_FIELDS',json.dumps([x for x in c.get_model('mrp.production').fields_get().keys() if x in ['bom_id','product_id','product_qty','origin','date_start','date_finished','company_id','picking_type_id','location_src_id','location_dest_id']]))\nprint('WO_FIELDS',json.dumps([x for x in c.get_model('mrp.workorder').fields_get().keys() if x in ['workcenter_id','production_id','date_start','date_finished','duration_expected']]))"},"binding_digest":"c81f879c7b7b782bae1f86351c61b166dfee3b8478086e6a73dcf76b2333978e","call_id":"call_7","caller_execution_ref":{"entity_type":"operation_execution_lease/v1","logical_id":"operation_execution_lease:b6a70b1b6f08502aa1234e793851f6db","version_id":"operation_execution_lease_version:bb7f0c27e40559129834ae0dde6ae13a"},"caller_firing_ref":{"entity_type":"transition_firing/v1","logical_id":"transition_firing:e98cc36