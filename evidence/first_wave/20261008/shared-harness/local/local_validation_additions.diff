+    before = (core.event_store.max_ordinal(), core.event_store.writer_epoch)
+    rows = [dict(row) for row in core.event_store.object_rows()]
+    by_version = {row['version_id']: row for row in rows}
+    def read(ref):
+        ref = normalize(ref)
+        row = by_version[ref['version_id']]
