+@pytest.mark.parametrize("kind", ["result", "status"])
+def test_descriptors_default_to_registered_size_and_keep_explicit_budget(tmp_path, monkeypatch, kind):
+    owner = owner_at(tmp_path / "run"); finish(owner)
+    original = ObjectStore.read_registered
+    sizes = []
+    def bounded(self, selected, *, max_bytes=None):
+        if selected.object_type != "resource_version/v1":
+            assert max_bytes == selected.size
+            sizes.append(selected.size)
+        return original(self, selected, max_bytes=max_bytes)
+    with monkeypatch.context() as context:
+        context.setattr(ObjectStore, "read_registered", bounded)
+        consume(control_at(owner), kind)
+    limit = max(sizes)
+    core = owner._core
+    kernel = _ResourceServiceKernel(core)
+    # Caller budget is still honored, including its exact acceptance boundary.
+    assert run_authority.read_run_execution(core, kernel, max_descriptor_bytes=limit).terminal
+    with pytest.raises(RuntimeError, match="descriptor exceeds reader byte bound"):
+        run_authority.read_run_execution(core, kernel, max_descriptor_bytes=limit - 1)
