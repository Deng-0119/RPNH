+def test_consumer_reuses_native_read_and_rechecks_same_cut_after_counts(tmp_path, monkeypatch, kind):
+    owner = owner_at(tmp_path / "run"); finish(owner)
+    control = control_at(owner)
+    real_read = run_authority.read_run_execution
+    real_bytes = run_authority.read_run_terminal_bytes
+    real_guard = run_authority.RunReadCut.assert_unchanged
+    trace = []
+    def read(core, kernel, **kwargs):
+        assert core.read_only is True
+        value = real_read(core, kernel, **kwargs)
+        trace.append(("read", value.cut))
+        return value
+    def body(core, value, **kwargs):
+        assert kwargs["max_bytes"] == value.terminal.result.size
+        trace.append(("body", value.cut))
+        return real_bytes(core, value, **kwargs)
+    def counts(self):
+        trace.append(("counts", None))
+        return (13, 2)  # Distinguish the existing cumulative projection from 0/1.
+    def guard(cut, core):
+        trace.append(("guard", cut))
+        return real_guard(cut, core)
+    monkeypatch.setattr(run_authority, "read_run_execution", read)
+    monkeypatch.setattr(run_authority, "read_run_terminal_bytes", body)
+    monkeypatch.setattr(run_authority.RunReadCut, "assert_unchanged", guard)
+    monkeypatch.setattr(EventStore, "actual_model_call_counts", counts)
+    result = consume(control, kind)
+    selected = [cut for event, cut in trace if event == "read"]
+    assert len(selected) == 1 and result["actual_model_call_counts"] == [13, 2]
+    assert trace[-2][0] == "counts" and trace[-1] == ("guard", selected[0])
+    assert all(cut is selected[0] for event, cut in trace if event in {"body", "guard"})
