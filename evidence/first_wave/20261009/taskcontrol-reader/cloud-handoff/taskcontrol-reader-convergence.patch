+def finish(owner, output="canonical result"):
+    admission = owner.admit("finish.run", logical_tau=0,
+                            command_id="admit", prepare_admission=None)
+    execution = owner.start(admission, command_id="start")
+    products = owner.products(execution, outcome_id="complete",
+        products={"finish.result": (canonical_json(output),)}, command_id="products")
+    owner.succeed(products, command_id="success")
+    return _ref_payload(owner.terminal())
