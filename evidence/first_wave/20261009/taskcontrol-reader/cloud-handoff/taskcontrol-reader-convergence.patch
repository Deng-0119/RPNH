+PAYLOAD = "application/task_reader_test/v1"
+EXECUTOR = "test/task-reader-no-dispatch/v1"
+TERMINAL = "test/task-reader-terminal/v1"
+MODEL = "offline-static-no-provider"
+RESULT_KEYS = {"task_id", "kind", "terminal_evidence_ref", "terminal_result_ref",
+               "run_outcome", "execution_generation", "output", "actual_model_call_counts"}
