+@pytest.mark.parametrize("kind", ["result", "status"])
+def test_descriptor_backing_growth_is_bounded_without_truncation(tmp_path, monkeypatch, kind):
+    owner = owner_at(tmp_path / "run")
+    evidence = _version_from_payload(finish(owner))
+    prepared = owner._core.get_version(evidence.version_id)
+    path = owner._core.object_store.path_for_version(evidence.version_id)
+    path.write_bytes(path.read_bytes() + b" " * 100)
+    original = ObjectStore.read_registered
+    calls = []
+    def bounded(self, selected, *, max_bytes=None):
+        if selected.version_id == evidence.version_id:
+            calls.append(max_bytes)
+            assert max_bytes == prepared.size
+        return original(self, selected, max_bytes=max_bytes)
+    monkeypatch.setattr(ObjectStore, "read_registered", bounded)
+    with pytest.raises(RuntimeError, match="readable exact immutable bytes"):
+        consume(control_at(owner), kind)
+    assert calls == [prepared.size]
+
