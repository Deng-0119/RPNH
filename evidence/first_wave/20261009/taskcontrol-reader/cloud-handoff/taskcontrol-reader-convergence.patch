+def test_registered_nonzero_call_baseline_remains_cumulative_across_generations(tmp_path):
+    from dataclasses import replace
+    owner = owner_at(tmp_path / "run")
+    core = owner._core
+    read = run_authority.read_run_execution(core, _ResourceServiceKernel(core))
+    source_run = replace(read.run_ref, entity_id=new_id("run"), version_id=new_id("run_version"))
+    core.event_store.install_published_model_call_baseline_v1(
+        source_run_ref=_ref_payload(source_run), source_task_ref=_ref_payload(read.task_ref),
+        source_checkpoint_ref=_ref_payload(read.checkpoint_ref), exact_model=MODEL,
+        published_call_count=2, idempotency_key="fixture-imported-calls")
+    finish(owner)
+    control = control_at(owner)
+    assert control.result("task-fixture")["actual_model_call_counts"] == [2, 0]
+    owner = reenter(owner)
+    assert consume(control, "status")["actual_model_call_counts"] == [2, 0]
+    owner.terminal()
+    before = fingerprint(owner)
+    assert control.result("task-fixture")["actual_model_call_counts"] == [2, 0]
+    assert consume(control, "status")["actual_model_call_counts"] == [2, 0]
+    assert fingerprint(owner) == before
