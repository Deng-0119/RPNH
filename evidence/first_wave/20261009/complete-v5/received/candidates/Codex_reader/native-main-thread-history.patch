+    with service.core.event_store.connect() as db:
+        db.execute("UPDATE registry_meta SET value=? WHERE key='branch_id'", ("changed",))
+    with pytest.raises(MainThreadAuthorityError, match="Registry"):
+        service.project_thread_at(cut)
