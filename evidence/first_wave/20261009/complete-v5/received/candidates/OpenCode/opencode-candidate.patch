+    monkeypatch.setattr("cpn.rpnh.main_session.resume_agent_task", guard.deny("resume_agent_task"))
+    monkeypatch.setattr(port, "request_once", guard.deny("fake_port"))
+    for name in ("_spawn", "start", "resume", "reopen", "stop", "message"):
