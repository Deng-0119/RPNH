+        "adapter_kind": "local_process", "model_condition": "offline-entry-stop",
+        "argv": [sys.executable, "-c", "pass"], "probe_argv": [sys.executable, "-c", "pass"],
+        "env": {}, "inherit_env": []}))
+    selection = LLMExecutionSelection(LLMInputTarget("offline-entry-stop", 1024, 65536),
+        "local_process", adapter, 30)
+    counts = {"port_close": 0, "loop_close": 0, "stop": 0}
+
+    def unexpected_request(*args):
+        raise AssertionError("an early stop must never dispatch a provider")
+
+    class HostPort:
+        request_once = staticmethod(unexpected_request)
+
+        def close(self):
+            counts["port_close"] += 1
+
+    class HostLoop(loop_factory):
