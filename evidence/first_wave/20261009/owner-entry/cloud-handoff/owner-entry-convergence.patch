+def test_entry_stop_drains_admitted_siblings_without_new_work(tmp_path, loop_factory, monkeypatch):
+    entered = {name: threading.Event() for name in ("usage", "tariff")}
+    release = threading.Event()
+    originals = {name: tools.TOOLS["read_" + name] for name in entered}
+
+    def gated_read(name):
+        async def invoke(**kwargs):
+            entered[name].set()
+            if not release.wait(180):
+                raise AssertionError("stop-drain read gate was not released")
+            return await originals[name](**kwargs)
+        return invoke
+
+    for name in entered:
+        monkeypatch.setitem(tools.TOOLS, "read_" + name, gated_read(name))
+    owner = create_owner(tmp_path / "run", selected_registration=registration(test_identity="stop-drain/v1"))
+    loop = loop_factory(owner, tmp_path / "owner.sock")
+    try:
+        with ThreadPoolExecutor(max_workers=2) as pool:
+            entry = make_orchestrator(owner, loop, pool)
+            observation_error = None
+            try:
+                assert len(entry.executor.schedule_ready()) == 2
+                _pump(loop, entry, lambda: all(event.is_set() for event in entered.values()))
+                assert len(_snapshot(owner)["active"]) == 2
+                entry.request_owner_stop()
+            except BaseException as exc:
+                observation_error = exc
+            finally:
+                release.set()
+            try:
+                result = entry.run()
+            finally:
+                if observation_error is not None:
+                    raise observation_error
+            assert result.stop_reason == "stopped_by_owner"
+            assert {row.transition_id for row in result.operation_execution_trace} == {
+                "read_usage.run", "read_tariff.run"}
+            assert not entry.executor._pending and not _snapshot(owner)["active"]
+            evidence = inspect_registry(owner._core)
+            assert not evidence["terminal_evidence"]
+            assert len(evidence["firings"]) == 2
+            assert all(row["state"] == "PUBLISHED" for row in evidence["firings"])
+            assert {row["value"]["stage"] for row in evidence["resources"]} == {
+                "usage_raw", "usage_validation_source", "tariff_raw", "tariff_validation_source"}
+            # Borrowed resources remain usable until the host's own cleanup.
