+def _observable_execution(evidence):
+    """Compare semantic values and causal resource roles across fresh run IDs."""
+    roles = {item["ref"]["resource_version_id"]: item["value"]["stage"]
+             for item in evidence["resources"]}
+    for item in evidence["resources"]:
+        for name, ref in item["value"]["source_refs"].items():
+            roles.setdefault(ref["resource_version_id"], "source_" + name)
+
+    def semantic(value):
+        if isinstance(value, dict):
+            if set(value) == {"resource_id", "resource_version_id"}:
+                return {"resource_role": roles[value["resource_version_id"]]}
+            return {key: semantic(item) for key, item in value.items()}
+        if isinstance(value, list):
+            return [semantic(item) for item in value]
+        return value
+
+    return {
+        "resources": sorted((semantic(item["value"]) for item in evidence["resources"]),
+                            key=lambda value: value["stage"]),
+        "firings": sorted((item["firing"]["transition_id"], item["state"],
+            item["firing_completion"]["business_outcome"],
+            [event["event_type"] for event in item["ordered_event_records"]])
+            for item in evidence["firings"]),
+        "terminal_outcomes": [item["run_outcome"] for item in evidence["terminal_evidence"]],
+        "model_calls": evidence["actual_model_call_counts"],
+    }
