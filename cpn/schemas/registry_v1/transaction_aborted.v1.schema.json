{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/transaction_aborted/v1",
  "title": "Aborted one-firing publication transaction",
  "type": "object",
  "additionalProperties": false,
  "definitions": {"ref": {"type": "object", "additionalProperties": false, "properties": {"entity_type": {"type": "string"}, "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}, "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}}, "required": ["entity_type", "logical_id", "version_id"]}},
  "properties": {"event_ref": {"$ref": "#/definitions/ref"}, "transaction_ref": {"$ref": "#/definitions/ref"}, "transition_firing_ref": {"$ref": "#/definitions/ref"}, "reason": {"type": "string", "minLength": 1}, "aborted_at_utc": {"type": "string", "format": "date-time"}},
  "required": ["event_ref", "transaction_ref", "transition_firing_ref", "reason", "aborted_at_utc"]
}
