    "response_resource_ref":{"$ref":"#/definitions/resource_ref"},
    "response_size":{"type":"integer","minimum":1},
    "finish_reason":{"type":["string","null"]},
    "external_request_id":{"type":["string","null"]}
  },
  "required":["provider_attempt_id","provider_attempt_version_id","provider_attempt_ref","llm_call_ref","invocation_ref","dispatch_event_id","response_resource_ref","response_size","finish_reason","external_request_id"]
}
