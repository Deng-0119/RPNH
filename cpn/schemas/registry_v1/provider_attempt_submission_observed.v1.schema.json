{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "$id":"registry_v1/provider_attempt_submission_observed/v1",
  "title":"provider_attempt_submission_observed/v1",
  "type":"object",
  "additionalProperties":false,
  "definitions": {
