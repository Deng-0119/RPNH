{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/provider_attempt_spec/v1",
  "title": "Current provider attempt with model and route provenance",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {"type": "object", "additionalProperties": false, "properties": {"entity_type": {"type": "string", "minLength": 1}, "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}, "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}}, "required": ["entity_type", "logical_id", "version_id"]},
    "nullable_ref": {"oneOf": [{"$ref": "#/definitions/ref"}, {"type": "null"}]},
    "resource_ref": {"type": "object", "additionalProperties": false, "properties": {"resource_id": {"type": "string", "pattern": "^resource:[a-f0-9]{32}$"}, "resource_version_id": {"type": "string", "pattern": "^resource_version:[a-f0-9]{32}$"}}, "required": ["resource_id", "resource_version_id"]}
  },
  "properties": {
    "provider_attempt_id": {"type": "string", "pattern": "^provider_attempt:[a-f0-9]{32}$"},
    "provider_attempt_version_id": {"type": "string", "pattern": "^provider_attempt_version:[a-f0-9]{32}$"},
    "provider_attempt_ref": {"$ref": "#/definitions/ref"},
    "llm_call_ref": {"$ref": "#/definitions/ref"},
    "invocation_ref": {"$ref": "#/definitions/ref"},
    "operation_binding_ref": {"$ref": "#/definitions/ref"},
    "llm_execution_target_ref": {"$ref": "#/definitions/resource_ref"},
    "request_resource_ref": {"$ref": "#/definitions/resource_ref"},
    "terminal_delivery_ref": {"$ref": "#/definitions/ref"},
    "budget_witness_ref": {"$ref": "#/definitions/ref"},
    "prior_attempt_ref": {"$ref": "#/definitions/nullable_ref"},
    "llm_call_id": {"type": "string", "pattern": "^llm_call:[a-f0-9]{32}$"},
    "llm_call_version_id": {"type": "string", "pattern": "^llm_call_version:[a-f0-9]{32}$"},
    "invocation_id": {"type": "string", "pattern": "^invocation:[a-f0-9]{32}$"},
    "invocation_version_id": {"type": "string", "pattern": "^invocation_version:[a-f0-9]{32}$"},
    "activation_id": {"type": ["string", "null"], "pattern": "^a2c_activation:[a-f0-9]{32}$"},
    "origin": {"type": "string", "minLength": 1},
    "accounting_parent_invocation_id": {"type": "string", "pattern": "^invocation:[a-f0-9]{32}$"},
    "accounting_parent_invocation_version_id": {"type": "string", "pattern": "^invocation_version:[a-f0-9]{32}$"},
    "backend_config_version_id": {"type": "string", "pattern": "^resource_version:[a-f0-9]{32}$"},
    "budget_witness_version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"},
    "resource_contract_version_id": {"type": "null"},
    "backend": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "transport_kind": {"type": "string", "minLength": 1},
    "response_protocol": {"type": "string", "minLength": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "retry_cause": {"type": ["string", "null"]},
    "prior_attempt_version_id": {"type": ["string", "null"], "pattern": "^provider_attempt_version:[a-f0-9]{32}$"},
    "reservation_class": {"type": "string", "minLength": 1},
    "finalization_scope": {"type": ["string", "null"]},
    "writer_fencing_epoch": {"type": "integer", "minimum": 1}
  },
  "required": ["provider_attempt_id", "provider_attempt_version_id", "provider_attempt_ref", "llm_call_ref", "invocation_ref", "operation_binding_ref", "llm_execution_target_ref", "request_resource_ref", "terminal_delivery_ref", "budget_witness_ref", "prior_attempt_ref", "llm_call_id", "llm_call_version_id", "invocation_id", "invocation_version_id", "activation_id", "origin", "accounting_parent_invocation_id", "accounting_parent_invocation_version_id", "backend_config_version_id", "budget_witness_version_id", "resource_contract_version_id", "backend", "model", "transport_kind", "response_protocol", "timeout_seconds", "retry_cause", "prior_attempt_version_id", "reservation_class", "finalization_scope", "writer_fencing_epoch"]
}
