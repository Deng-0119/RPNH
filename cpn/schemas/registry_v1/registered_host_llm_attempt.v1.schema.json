{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/registered_host_llm_attempt/v1",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {"type": "object", "additionalProperties": false, "properties": {"entity_type": {"type": "string", "minLength": 1}, "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}, "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}}, "required": ["entity_type", "logical_id", "version_id"]},
    "resource_ref": {"type": "object", "additionalProperties": false, "properties": {"resource_id": {"type": "string", "pattern": "^resource:[a-f0-9]{32}$"}, "resource_version_id": {"type": "string", "pattern": "^resource_version:[a-f0-9]{32}$"}}, "required": ["resource_id", "resource_version_id"]}
  },
  "properties": {
    "registered_host_llm_attempt_id": {"type": "string", "pattern": "^registered_host_llm_attempt:[a-f0-9]{32}$"},
    "registered_host_llm_attempt_version_id": {"type": "string", "pattern": "^registered_host_llm_attempt_version:[a-f0-9]{32}$"},
    "registered_host_llm_attempt_ref": {"$ref": "#/definitions/ref"},
    "invocation_kind": {"const": "registered_host"},
    "invocation_ref": {"$ref": "#/definitions/ref"},
    "operation_binding_ref": {"$ref": "#/definitions/ref"},
    "llm_call_ref": {"$ref": "#/definitions/ref"},
    "provider_attempt_ref": {"$ref": "#/definitions/ref"},
    "request_resource_ref": {"$ref": "#/definitions/resource_ref"},
    "model_condition": {"type": "string", "minLength": 1},
    "max_response_bytes": {"type": "integer", "minimum": 1},
    "attempt_ordinal": {"const": 0}
  },
  "required": ["registered_host_llm_attempt_id", "registered_host_llm_attempt_version_id", "registered_host_llm_attempt_ref", "invocation_kind", "invocation_ref", "operation_binding_ref", "llm_call_ref", "provider_attempt_ref", "request_resource_ref", "model_condition", "max_response_bytes", "attempt_ordinal"]
}
