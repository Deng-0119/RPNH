{
  "$id": "registry_v1/transition_firing/v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"type": "string"},
        "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}
      },
      "required": ["entity_type", "logical_id", "version_id"]
    },
    "nullable_ref": {"oneOf": [{"$ref": "#/definitions/ref"}, {"type": "null"}]}
  },
  "properties": {
    "transition_firing_ref": {"$ref": "#/definitions/ref"},
    "transition_id": {"type": "string", "minLength": 1},
    "attempt_index": {"type": "integer", "minimum": 1},
    "activation_ref": {"oneOf": [{"$ref": "#/definitions/ref"}, {"type": "null"}]},
    "task_ref": {"$ref": "#/definitions/ref"},
    "task_branch_ref": {"$ref": "#/definitions/ref"},
    "task_round_ref": {"$ref": "#/definitions/ref"},
    "net_instance_ref": {"$ref": "#/definitions/ref"},
    "plan_ref": {"$ref": "#/definitions/ref"},
    "node_ref": {"$ref": "#/definitions/ref"},
    "agent_ref": {"$ref": "#/definitions/nullable_ref"},
    "operation_binding_ref": {"$ref": "#/definitions/ref"},
    "principal_ref": {"$ref": "#/definitions/ref"},
    "admission_marking_checkpoint_ref": {"$ref": "#/definitions/ref"},
    "budget_witness_ref": {"$ref": "#/definitions/ref"},
    "firing_admission_ref": {"$ref": "#/definitions/ref"},
    "claim_marking_delta_ref": {"$ref": "#/definitions/ref"},
    "logical_tau": {"type": ["integer", "number", "string"]},
    "claimed_input_refs": {"type": "array", "items": {"$ref": "#/definitions/ref"}, "uniqueItems": true},
    "claimed_input_version_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}, "uniqueItems": true}
  },
  "required": ["transition_firing_ref", "transition_id", "attempt_index", "activation_ref", "task_ref", "task_branch_ref", "task_round_ref", "net_instance_ref", "plan_ref", "node_ref", "agent_ref", "operation_binding_ref", "principal_ref", "admission_marking_checkpoint_ref", "budget_witness_ref", "firing_admission_ref", "claim_marking_delta_ref", "logical_tau", "claimed_input_refs", "claimed_input_version_ids"]
}
