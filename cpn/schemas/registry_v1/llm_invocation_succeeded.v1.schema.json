{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/llm_invocation_succeeded/v1",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {"type": "object", "additionalProperties": false,
      "properties": {"entity_type": {"type": "string"}, "logical_id": {"type": "string"}, "version_id": {"type": "string"}},
      "required": ["entity_type", "logical_id", "version_id"]},
    "resource_ref": {"type": "object", "additionalProperties": false,
      "properties": {"resource_id": {"type": "string"}, "resource_version_id": {"type": "string"}},
      "required": ["resource_id", "resource_version_id"]}
  },
  "properties": {
    "llm_invocation_ref": {"$ref": "#/definitions/ref"},
    "llm_invocation_attempt_ref": {"$ref": "#/definitions/ref"},
    "response_resource_ref": {"$ref": "#/definitions/resource_ref"},
    "agent_turn_ref": {"$ref": "#/definitions/ref"},
    "agent_context_compaction_ref": {"$ref": "#/definitions/ref"},
    "turn_sequence": {"type": "integer", "minimum": 0}
  },
  "required": [
    "llm_invocation_ref", "llm_invocation_attempt_ref",
    "response_resource_ref", "turn_sequence"
  ],
  "oneOf": [
    {
      "required": ["agent_turn_ref"],
      "not": {"required": ["agent_context_compaction_ref"]}
    },
    {
      "required": ["agent_context_compaction_ref"],
      "not": {"required": ["agent_turn_ref"]}
    },
    {
      "not": {"anyOf": [
        {"required": ["agent_turn_ref"]},
        {"required": ["agent_context_compaction_ref"]}
      ]}
    }
  ]
}
