{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/semantic_prompt_authority/v1",
  "title": "Exact registered semantic role-prompt authority",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {"type": "object", "additionalProperties": false, "properties": {"entity_type": {"type": "string"}, "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}, "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}}, "required": ["entity_type", "logical_id", "version_id"]},
    "resource_ref": {"type": "object", "additionalProperties": false, "properties": {"resource_id": {"type": "string", "pattern": "^resource:[a-f0-9]{32}$"}, "resource_version_id": {"type": "string", "pattern": "^resource_version:[a-f0-9]{32}$"}}, "required": ["resource_id", "resource_version_id"]}
  },
  "properties": {
    "prompt_authority_ref": {"$ref": "#/definitions/ref"},
    "role_identity_ref": {"$ref": "#/definitions/ref"},
    "prompt_resource_ref": {"$ref": "#/definitions/resource_ref"},
    "semantic_role": {"enum": ["intake", "intake_critic", "team_designer", "design_critic", "generic_critic", "reviewer_a", "reviewer_b"]},
    "authority_kind": {"const": "registered_resource_only"}
  },
  "required": ["prompt_authority_ref", "role_identity_ref", "prompt_resource_ref", "semantic_role", "authority_kind"]
}
