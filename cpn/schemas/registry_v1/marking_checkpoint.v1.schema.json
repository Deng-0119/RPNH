{
  "$id": "registry_v1/marking_checkpoint/v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Settled Registry Petri marking checkpoint",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_type": {"type": "string"},
        "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}
      },
      "required": ["entity_type", "logical_id", "version_id"]
    },
    "marking_checkpoint_ref": {
      "allOf": [
        {"$ref": "#/definitions/ref"},
        {"properties": {"entity_type": {"const": "marking_checkpoint/v1"}}}
      ]
    },
    "net_instance_ref": {
      "allOf": [
        {"$ref": "#/definitions/ref"},
        {"properties": {"entity_type": {"const": "net_instance/v1"}}}
      ]
    },
    "nullable_ref": {"oneOf": [{"$ref": "#/definitions/ref"}, {"type": "null"}]},
    "nullable_marking_checkpoint_ref": {
      "oneOf": [
        {"$ref": "#/definitions/marking_checkpoint_ref"},
        {"type": "null"}
      ]
    },
    "business_firing_ref": {"allOf": [{"$ref": "#/definitions/ref"}, {"properties": {"entity_type": {"const": "transition_firing/v1"}}}]},
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transition_id": {"type": "string", "minLength": 1},
        "highest_issued": {"type": "integer", "minimum": 1}
      },
      "required": ["transition_id", "highest_issued"]
    },
    "reentry_token_mapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_token_ref": {"$ref": "#/definitions/ref"},
        "replacement_token_ref": {"$ref": "#/definitions/ref"}
      },
      "required": ["source_token_ref", "replacement_token_ref"]
    }
  },
  "properties": {
    "owner_command_ref": {"$ref": "#/definitions/ref"},
    "owner_command_result_ref": {"$ref": "#/definitions/ref"},
    "marking_checkpoint_ref": {"$ref": "#/definitions/marking_checkpoint_ref"},
    "net_instance_ref": {"$ref": "#/definitions/net_instance_ref"},
    "team_design_root_ref": {"$ref": "#/definitions/ref"},
    "epoch": {"type": "integer", "minimum": 0},
    "next_token_id": {"type": "integer", "minimum": 0},
    "attempts": {"type": "array", "items": {"$ref": "#/definitions/attempt"}, "uniqueItems": true},
    "token_refs": {"type": "array", "items": {"$ref": "#/definitions/ref"}, "uniqueItems": true},
    "settled": {"const": true},
    "previous_checkpoint_ref": {"$ref": "#/definitions/nullable_marking_checkpoint_ref"},
    "settlement_delta_ref": {"$ref": "#/definitions/nullable_ref"},
    "transition_firing_refs": {"type": "array", "items": {"$ref": "#/definitions/business_firing_ref"}, "uniqueItems": true},
    "workspace_revision_refs": {"type": "array", "items": {"$ref": "#/definitions/ref"}, "uniqueItems": true}
    ,"reentry_source_checkpoint_ref": {"$ref": "#/definitions/marking_checkpoint_ref"}
    ,"reentry_authorization_ref": {"$ref": "#/definitions/ref"}
    ,"reentry_superseded_terminal_evidence_ref": {"$ref": "#/definitions/nullable_ref"}
    ,"reentry_generation": {"type": "integer", "minimum": 1}
    ,"reentry_token_mappings": {"type": "array", "items": {"$ref": "#/definitions/reentry_token_mapping"}, "uniqueItems": true}
    ,"reentry_superseded_token_refs": {"type": "array", "items": {"$ref": "#/definitions/ref"}, "uniqueItems": true}
  },
  "allOf": [{"if": {"anyOf": [{"required": ["owner_command_ref"]}, {"required": ["owner_command_result_ref"]}]},
    "then": {"required": ["owner_command_ref", "owner_command_result_ref"],
      "properties": {"previous_checkpoint_ref": {"$ref": "#/definitions/ref"},
        "settlement_delta_ref": {"type": "null"}, "transition_firing_refs": {"maxItems": 0}}}},
    {"if": {"anyOf": [
        {"required": ["reentry_source_checkpoint_ref"]},
        {"required": ["reentry_authorization_ref"]},
        {"required": ["reentry_superseded_terminal_evidence_ref"]},
        {"required": ["reentry_generation"]},
        {"required": ["reentry_token_mappings"]},
        {"required": ["reentry_superseded_token_refs"]}
      ]},
     "then": {"required": ["reentry_source_checkpoint_ref",
        "reentry_authorization_ref", "reentry_superseded_terminal_evidence_ref",
        "reentry_generation", "reentry_token_mappings",
        "reentry_superseded_token_refs"],
       "properties": {"previous_checkpoint_ref": {"$ref": "#/definitions/ref"},
         "settlement_delta_ref": {"type": "null"},
         "transition_firing_refs": {"maxItems": 0}}}}
  ],
  "required": [
    "marking_checkpoint_ref", "net_instance_ref", "team_design_root_ref",
    "epoch", "next_token_id", "attempts", "token_refs", "settled",
    "previous_checkpoint_ref", "settlement_delta_ref",
    "transition_firing_refs"
  ]
}
