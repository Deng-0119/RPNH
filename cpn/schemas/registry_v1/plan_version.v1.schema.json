{
  "$id": "registry_v1/plan_version/v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
    "node_ids": {
      "items": {
        "pattern": "^node:[a-f0-9]{32}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "plan_id": {
      "pattern": "^plan:[a-f0-9]{32}$",
      "type": "string"
    },
    "plan_version_id": {
      "pattern": "^plan_version:[a-f0-9]{32}$",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "plan_version_id",
    "node_ids"
  ],
  "title": "plan_version/v1",
  "type": "object"
}
