{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/llm_call_spec/v3",
  "title": "Registered-HOST source-neutral LLM call",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {"type": "object", "additionalProperties": false, "properties": {"entity_type": {"type": "string", "minLength": 1}, "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}, "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}}, "required": ["entity_type", "logical_id", "version_id"]},
    "resource_ref": {"type": "object", "additionalProperties": false, "properties": {"resource_id": {"type": "string", "pattern": "^resource:[a-f0-9]{32}$"}, "resource_version_id": {"type": "string", "pattern": "^resource_version:[a-f0-9]{32}$"}}, "required": ["resource_id", "resource_version_id"]}
  },
  "properties": {
    "llm_call_id": {"type": "string", "pattern": "^llm_call:[a-f0-9]{32}$"},
    "llm_call_version_id": {"type": "string", "pattern": "^llm_call_version:[a-f0-9]{32}$"},
    "llm_call_ref": {"$ref": "#/definitions/ref"},
    "invocation_kind": {"const": "registered_host"},
    "invocation_ref": {"$ref": "#/definitions/ref"},
    "operation_binding_ref": {"$ref": "#/definitions/ref"},
    "request_resource_ref": {"$ref": "#/definitions/resource_ref"},
    "terminal_delivery_ref": {"$ref": "#/definitions/ref"},
    "semantic_prompt_resource_ref": {"$ref": "#/definitions/resource_ref"},
    "llm_input_target_ref": {"$ref": "#/definitions/resource_ref"},
    "llm_execution_target_ref": {"$ref": "#/definitions/resource_ref"},
    "backend": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "transport_contract_ref": {"$ref": "#/definitions/resource_ref"},
    "interaction_protocol_ref": {"const": "llm_request_envelope/v1"},
    "response_adapter_ref": {"const": "llm_response_envelope/v1"},
    "tool_catalog_ref": {"$ref": "#/definitions/resource_ref"},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "max_response_bytes": {"type": "integer", "minimum": 1}
  },
  "required": ["llm_call_id", "llm_call_version_id", "llm_call_ref", "invocation_kind", "invocation_ref", "operation_binding_ref", "request_resource_ref", "terminal_delivery_ref", "semantic_prompt_resource_ref", "llm_input_target_ref", "llm_execution_target_ref", "backend", "model", "transport_contract_ref", "interaction_protocol_ref", "response_adapter_ref", "tool_catalog_ref", "timeout_seconds", "max_response_bytes"]
}
