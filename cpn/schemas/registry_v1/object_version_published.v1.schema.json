{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/object_version_published/v1",
  "title": "Current Registry object version publication payload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"},
    "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"},
    "object_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*/v[1-9][0-9]*$"},
    "size": {"type": "integer", "minimum": 0},
    "media_type": {"type": "string", "minLength": 1},
    "schema_ref": {"type": "string", "pattern": "^registry_v1/[a-z][a-z0-9_]*/v[1-9][0-9]*$"},
    "storage_locator": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"}
  },
  "required": [
    "logical_id", "version_id", "object_type", "size",
    "media_type", "schema_ref", "storage_locator", "metadata"
  ]
}
