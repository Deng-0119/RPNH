  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {"type": "object", "additionalProperties": false, "properties": {"entity_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*/v[1-9][0-9]*$"}, "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}, "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}}, "required": ["entity_type", "logical_id", "version_id"]},
    "nullable_ref": {"oneOf": [{"$ref": "#/definitions/ref"}, {"type": "null"}]}
  },
  "properties": {
    "execution_terminal_mapping_ref": {"$ref": "#/definitions/ref"},
    "execution_instance_ref": {"$ref": "#/definitions/ref"},
    "execution_checkpoint_ref": {"$ref": "#/definitions/ref"},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/ref"}},
    "parent_invocation_ref": {"$ref": "#/definitions/ref"},
    "parent_business_firing_ref": {"$ref": "#/definitions/ref"},
    "operation_result_ref": {"$ref": "#/definitions/ref"},
    "successor_business_checkpoint_ref": {"$ref": "#/definitions/ref"},
    "workspace_revision_ref": {"$ref": "#/definitions/nullable_ref"},
    "business_outcome": {"type": "string", "minLength": 1}
  },
  "required": ["execution_terminal_mapping_ref", "execution_instance_ref", "execution_checkpoint_ref", "evidence_refs", "parent_invocation_ref", "parent_business_firing_ref", "operation_result_ref", "successor_business_checkpoint_ref", "workspace_revision_ref", "business_outcome"]
}
