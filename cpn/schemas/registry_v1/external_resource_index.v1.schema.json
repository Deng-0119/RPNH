{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/external_resource_index/v1",
  "title": "Thin run-scoped external-resource index",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {"type": "object", "additionalProperties": false, "properties": {"entity_type": {"type": "string"}, "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}, "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}}, "required": ["entity_type", "logical_id", "version_id"]},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_kind": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "package_ref": {"$ref": "#/definitions/ref"},
        "callable_interface_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "required": ["resource_kind", "description", "package_ref", "callable_interface_ids"]
    }
  },
  "properties": {
    "external_resource_index_ref": {"$ref": "#/definitions/ref"},
    "run_ref": {"$ref": "#/definitions/ref"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/entry"}}
  },
  "required": ["external_resource_index_ref", "run_ref", "entries"]
}
