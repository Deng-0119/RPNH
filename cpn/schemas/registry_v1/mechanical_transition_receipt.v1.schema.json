{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/mechanical_transition_receipt/v1",
  "title": "Exact generic mechanical transition receipt",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "exact_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_type": {"type": "string", "minLength": 1},
        "logical_id": {"type": "string", "minLength": 1},
        "version_id": {"type": "string", "minLength": 1}
      },
      "required": ["entity_type", "logical_id", "version_id"]
    },
    "ref_list": {
      "type": "array",
      "items": {"$ref": "#/definitions/exact_ref"},
      "uniqueItems": true
    },
    "resource_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_id": {"type": "string", "pattern": "^resource:[a-f0-9]{32}$"},
        "resource_version_id": {"type": "string", "pattern": "^resource_version:[a-f0-9]{32}$"}
      },
      "required": ["resource_id", "resource_version_id"]
    },
    "resource_ref_list": {
      "type": "array",
      "items": {"$ref": "#/definitions/resource_ref"},
      "uniqueItems": true
    },
    "write_record": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "resource_ref": {"$ref": "#/definitions/resource_ref"},
        "agent_turn_ref": {"allOf": [{"$ref": "#/definitions/exact_ref"}, {"properties": {"entity_type": {"const": "agent_turn/v1"}}}]},
        "agent_action_ref": {"allOf": [{"$ref": "#/definitions/exact_ref"}, {"properties": {"entity_type": {"const": "agent_action/v2"}}}]},
        "turn_sequence": {"type": "integer", "minimum": 0},
        "tool_call_ordinal": {"type": "integer", "minimum": 0}
      },
      "required": ["resource_ref", "agent_turn_ref", "agent_action_ref", "turn_sequence", "tool_call_ordinal"]
    },
    "path_list": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "cap250_recent_action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_action_ref": {"$ref": "#/definitions/exact_ref"},
        "agent_loop_ref": {"$ref": "#/definitions/exact_ref"},
        "turn_sequence": {"type": "integer", "minimum": 0},
        "provider_ordinal": {"type": "integer", "minimum": 0},
        "tool_name": {"type": ["string", "null"]},
        "state": {"type": "string", "minLength": 1},
        "raw_arguments": {"type": ["string", "null"], "maxLength": 16384},
        "arguments_truncated": {"type": "boolean"},
        "result_refs": {"$ref": "#/definitions/ref_list"},
        "result_kind": {"type": ["string", "null"]},
        "result_status": {"type": ["string", "null"]},
        "result_path": {"type": ["string", "null"]},
        "exit_code": {"type": ["integer", "null"]},
        "stdout_tail": {"type": "string", "maxLength": 16384},
        "stderr_tail": {"type": "string", "maxLength": 16384},
        "output_truncated": {"type": "boolean"}
      },
      "required": ["agent_action_ref", "agent_loop_ref", "turn_sequence", "provider_ordinal", "tool_name", "state", "raw_arguments", "arguments_truncated", "result_refs", "result_kind", "result_status", "result_path", "exit_code", "stdout_tail", "stderr_tail", "output_truncated"]
    },
    "review_target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_ref": {
          "allOf": [
            {"$ref": "#/definitions/exact_ref"},
            {"properties": {"entity_type": {"const": "node_declaration/v1"}}}
          ]
        },
        "semantic_node_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "node_synopsis": {"type": "string", "minLength": 1},
        "producer_transition_id": {"type": "string", "minLength": 1},
        "refire_transition_id": {"type": "string", "minLength": 1},
        "refire_place": {"type": "string", "minLength": 1},
        "dispatch_place": {"type": "string", "minLength": 1},
        "feedback_place": {"type": "string", "minLength": 1},
        "reset_places": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "required": ["node_ref", "semantic_node_id", "node_synopsis", "producer_transition_id", "refire_transition_id", "refire_place", "dispatch_place", "feedback_place", "reset_places"]
    },
    "review_target_catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalog_identity_ref": {
          "allOf": [
            {"$ref": "#/definitions/exact_ref"},
            {"properties": {"entity_type": {"const": "node_declaration/v1"}}}
          ]
        },
        "reviewer": {"enum": ["reviewer_a", "reviewer_b"]},
        "target_nodes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/review_target"},
          "uniqueItems": true
        }
      },
      "required": ["catalog_identity_ref", "reviewer", "target_nodes"]
    },
    "producer_file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_ref": {"$ref": "#/definitions/resource_ref"},
        "content_schema_ref": {"type": ["string", "null"]},
        "media_type": {"type": "string", "minLength": 1},
        "summary": {"type": ["string", "null"]},
        "descriptors": {"type": "object"},
        "transition_firing_ref": {"$ref": "#/definitions/exact_ref"},
        "settlement_ordinal": {"type": "integer", "minimum": 1},
        "resource_stream_sequence": {"type": "integer", "minimum": 1}
      },
      "required": ["resource_ref", "content_schema_ref", "media_type", "summary", "descriptors", "transition_firing_ref", "settlement_ordinal", "resource_stream_sequence"]
    },
    "producer_file_group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stable_agent_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "producer_node_ref": {"$ref": "#/definitions/exact_ref"},
        "producer_transition_id": {"type": "string", "minLength": 1},
        "current_settled_firing_ref": {"$ref": "#/definitions/exact_ref"},
        "current_settlement_ordinal": {"type": "integer", "minimum": 1},
        "current_files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/producer_file"},
          "uniqueItems": true
        },
        "prior_files": {
          "type": "array",
          "items": {"$ref": "#/definitions/producer_file"},
          "uniqueItems": true
        }
      },
      "required": ["stable_agent_id", "producer_node_ref", "producer_transition_id", "current_settled_firing_ref", "current_settlement_ordinal", "current_files", "prior_files"]
    },
    "actor_execution_fact_index": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": "registry_v1/actor_execution_fact_index/v1"},
        "execution_mode": {"enum": ["registered_operation", "agent_loop"]},
        "actor_invocation_ref": {"allOf": [{"$ref": "#/definitions/exact_ref"}, {"properties": {"entity_type": {"const": "invocation/v1"}}}]},
        "actor_transition_firing_ref": {"allOf": [{"$ref": "#/definitions/exact_ref"}, {"properties": {"entity_type": {"const": "transition_firing/v1"}}}]},
        "actor_agent_loop_ref": {"oneOf": [{"type": "null"}, {"allOf": [{"$ref": "#/definitions/exact_ref"}, {"properties": {"entity_type": {"const": "agent_loop/v1"}}}]}]},
        "original_task_resource_ref": {"$ref": "#/definitions/resource_ref"},
        "candidate_output_refs": {"$ref": "#/definitions/resource_ref_list"},
        "settled_action_refs": {"$ref": "#/definitions/ref_list"},
        "workspace_action_refs": {"$ref": "#/definitions/ref_list"},
        "workspace_setup_failure_error_refs": {"$ref": "#/definitions/ref_list"},
        "registered_write_records": {"type": "array", "items": {"$ref": "#/definitions/write_record"}, "uniqueItems": true},
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "call_count": {"type": "integer", "minimum": 0},
            "command_started_count": {"type": "integer", "minimum": 0},
            "command_not_started_count": {"type": "integer", "minimum": 0},
            "setup_failure_count": {"type": "integer", "minimum": 0},
            "completed_count": {"type": "integer", "minimum": 0},
            "timed_out_count": {"type": "integer", "minimum": 0},
            "zero_exit_count": {"type": "integer", "minimum": 0},
            "nonzero_exit_count": {"type": "integer", "minimum": 0}
          },
          "required": ["call_count", "command_started_count", "command_not_started_count", "setup_failure_count", "completed_count", "timed_out_count", "zero_exit_count", "nonzero_exit_count"]
        },
        "candidate_content_inspected": {"const": false}
      },
      "required": ["schema_version", "execution_mode", "actor_invocation_ref", "actor_transition_firing_ref", "actor_agent_loop_ref", "original_task_resource_ref", "candidate_output_refs", "settled_action_refs", "workspace_action_refs", "workspace_setup_failure_error_refs", "registered_write_records", "workspace", "candidate_content_inspected"]
    },
    "finalization_evidence_index": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "team_design_root_ref": {"$ref": "#/definitions/exact_ref"},
        "original_task_resource_refs": {"allOf": [{"$ref": "#/definitions/resource_ref_list"}, {"minItems": 1}]},
        "intake_document_refs": {"$ref": "#/definitions/resource_ref_list"},
        "design_resource_refs": {"$ref": "#/definitions/resource_ref_list"},
        "team_artifact_refs": {"$ref": "#/definitions/resource_ref_list"},
        "producer_file_groups": {
          "type": "array",
          "items": {"$ref": "#/definitions/producer_file_group"},
          "uniqueItems": true
        },
        "actor_execution_fact_indexes": {
          "type": "array",
          "items": {"$ref": "#/definitions/actor_execution_fact_index"},
          "uniqueItems": true
        },
        "disposition_document_refs": {"$ref": "#/definitions/resource_ref_list"},
        "review_target_catalogs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reviewer_a": {"$ref": "#/definitions/review_target_catalog"},
            "reviewer_b": {"$ref": "#/definitions/review_target_catalog"}
          },
          "oneOf": [
            {"maxProperties": 0},
            {"required": ["reviewer_a", "reviewer_b"]}
          ]
        }
      },
      "required": ["team_design_root_ref", "original_task_resource_refs", "intake_document_refs", "design_resource_refs", "team_artifact_refs", "producer_file_groups", "actor_execution_fact_indexes", "disposition_document_refs", "review_target_catalogs"]
    },
    "declared_id": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"}
  },
  "properties": {
    "schema_version": {"const": "registry_v1/mechanical_transition_receipt/v1"},
    "transition_firing_ref": {"$ref": "#/definitions/exact_ref"},
    "operation_spec_ref": {"$ref": "#/definitions/exact_ref"},
    "operation_binding_ref": {"$ref": "#/definitions/exact_ref"},
    "claimed_input_refs": {"$ref": "#/definitions/ref_list"},
    "claimed_lease_refs": {"$ref": "#/definitions/ref_list"},
    "forwarded_artifact_refs": {"$ref": "#/definitions/resource_ref_list"},
    "declared_transition_id": {"$ref": "#/definitions/declared_id"},
    "declared_outcome_id": {"oneOf": [{"$ref": "#/definitions/declared_id"}, {"type": "null"}]},
    "declared_settlement_id": {"$ref": "#/definitions/declared_id"},
    "finalization_evidence_index": {"$ref": "#/definitions/finalization_evidence_index"},
    "cap250_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {"const": "cap250_exhausted"},
        "normal_model_calls": {"type": "integer", "minimum": 1},
        "normal_model_call_limit": {"type": "integer", "minimum": 1},
        "extra_model_calls": {"type": "integer", "minimum": 0},
        "open_normal_firing_refs": {"type": "array", "maxItems": 0},
        "required_reviewer": {"const": "reviewer_b"},
        "decision_scope": {"const": ["complete", "failed"]}
      },
      "required": ["reason", "normal_model_calls", "normal_model_call_limit", "extra_model_calls", "open_normal_firing_refs", "required_reviewer", "decision_scope"]
    },
    "cap250_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "final_workspace_revision_ref": {"$ref": "#/definitions/exact_ref"},
        "final_workspace_inventory_paths": {"$ref": "#/definitions/path_list"},
        "workspace_revision_refs": {
          "allOf": [{"$ref": "#/definitions/ref_list"}, {"minItems": 1}]
        },
        "agent_loop_refs": {"$ref": "#/definitions/ref_list"},
        "agent_action_refs": {"$ref": "#/definitions/ref_list"},
        "recent_actions": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/definitions/cap250_recent_action"}
        },
        "semantic_output_refs": {"$ref": "#/definitions/resource_ref_list"},
        "trace_summary_refs": {"$ref": "#/definitions/resource_ref_list"}
      },
      "required": ["final_workspace_revision_ref", "final_workspace_inventory_paths", "workspace_revision_refs", "agent_loop_refs", "agent_action_refs", "recent_actions", "semantic_output_refs", "trace_summary_refs"]
    }
  },
  "dependencies": {
    "cap250_status": ["cap250_evidence"],
    "cap250_evidence": ["cap250_status"]
  },
  "required": ["schema_version", "transition_firing_ref", "operation_spec_ref", "operation_binding_ref", "claimed_input_refs", "claimed_lease_refs", "forwarded_artifact_refs", "declared_transition_id", "declared_outcome_id", "declared_settlement_id"]
}
