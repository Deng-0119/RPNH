{
  "$id": "registry_v1/petri_token/v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Exact typed Petri token occurrence",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {"type": "object", "additionalProperties": false, "properties": {"entity_type": {"type": "string"}, "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}, "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}}, "required": ["entity_type", "logical_id", "version_id"]},
    "resource_ref": {"type": "object", "additionalProperties": false, "properties": {"resource_id": {"type": "string", "pattern": "^resource:[a-f0-9]{32}$"}, "resource_version_id": {"type": "string", "pattern": "^resource_version:[a-f0-9]{32}$"}}, "required": ["resource_id", "resource_version_id"]},
    "nullable_resource_ref": {"oneOf": [{"$ref": "#/definitions/resource_ref"}, {"type": "null"}]},
    "nullable_exact_string": {"oneOf": [{"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"}, {"type": "null"}]},
    "override_warning": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "properties": {"reason": {"type": "string", "minLength": 1}, "gate_transition_id": {"type": "string", "minLength": 1}, "gate_peer_transition_id": {"type": "string", "minLength": 1}, "overridden_attempt": {"type": "string", "minLength": 1}, "escalation_provenance": {"type": "string", "minLength": 1}, "gate_output_place": {"type": "string", "minLength": 1}}, "required": ["reason", "gate_transition_id", "gate_peer_transition_id", "overridden_attempt", "escalation_provenance", "gate_output_place"]}]},
    "continuation": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "properties": {"round": {"type": "integer", "minimum": 0}, "source_ref": {"$ref": "#/definitions/resource_ref"}}, "required": ["round", "source_ref"]}]},
    "lease_identity_ref": {"oneOf": [{"type": "null"}, {"allOf": [{"$ref": "#/definitions/ref"}, {"properties": {"entity_type": {"enum": ["resource_version/v1", "logical_artifact_slot/v1"]}}}]}]},
    "lease_claim": {"type": "object", "additionalProperties": false, "properties": {"lease_identity_ref": {"allOf": [{"$ref": "#/definitions/ref"}, {"properties": {"entity_type": {"enum": ["resource_version/v1", "logical_artifact_slot/v1"]}}}]}, "expected_resource_ref": {"$ref": "#/definitions/nullable_resource_ref"}, "access_mode": {"enum": ["read", "edit", "produce"]}, "staging_place": {"type": "string", "minLength": 1}}, "required": ["lease_identity_ref", "expected_resource_ref", "access_mode"]}
  },
  "properties": {
    "petri_token_ref": {"$ref": "#/definitions/ref"},
    "net_instance_ref": {"$ref": "#/definitions/ref"},
    "token_id": {"type": "integer", "minimum": 0},
    "place": {"type": "string", "minLength": 1},
    "epoch": {"type": "integer", "minimum": 0},
    "producer": {"$ref": "#/definitions/nullable_exact_string"},
    "consumer": {"$ref": "#/definitions/nullable_exact_string"},
    "resource_ref": {"$ref": "#/definitions/nullable_resource_ref"},
    "work_resource_ref": {"$ref": "#/definitions/nullable_resource_ref"},
    "kind": {"$ref": "#/definitions/nullable_exact_string"},
    "consumed_by": {"$ref": "#/definitions/nullable_exact_string"},
    "override_warning": {"$ref": "#/definitions/override_warning"},
    "verdict": {"oneOf": [{"type": "boolean"}, {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"}, {"type": "null"}]},
    "continuation": {"$ref": "#/definitions/continuation"},
    "lease_identity_ref": {"$ref": "#/definitions/lease_identity_ref"},
    "lease_claims": {"type": "array", "items": {"$ref": "#/definitions/lease_claim"}, "uniqueItems": true}
  },
  "required": [
    "petri_token_ref", "net_instance_ref", "token_id",
    "place", "epoch", "producer", "consumer", "resource_ref",
    "work_resource_ref", "kind", "consumed_by",
    "override_warning", "verdict", "continuation", "lease_identity_ref",
    "lease_claims"
  ],
  "allOf": [
    {"if": {"properties": {"work_resource_ref": {"not": {"type": "null"}}}}, "then": {"properties": {"resource_ref": {"$ref": "#/definitions/resource_ref"}}}},
    {"if": {"properties": {"kind": {"not": {"type": "null"}}}}, "then": {"properties": {"resource_ref": {"$ref": "#/definitions/resource_ref"}}}}
  ]
}
