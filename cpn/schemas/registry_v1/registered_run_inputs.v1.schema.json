{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/registered_run_inputs/v1",
  "title": "Controlled run inputs and registered runtime policy",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {"type": "object", "additionalProperties": false, "properties": {"entity_type": {"type": "string"}, "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}, "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}}, "required": ["entity_type", "logical_id", "version_id"]},
    "resource_ref": {"type": "object", "additionalProperties": false, "properties": {"resource_id": {"type": "string", "pattern": "^resource:[a-f0-9]{32}$"}, "resource_version_id": {"type": "string", "pattern": "^resource_version:[a-f0-9]{32}$"}}, "required": ["resource_id", "resource_version_id"]}
  },
  "properties": {
    "registered_run_inputs_ref": {"$ref": "#/definitions/ref"},
    "raw_task_ref": {"$ref": "#/definitions/resource_ref"},
    "initial_workspace_ref": {"$ref": "#/definitions/ref"},
    "external_resource_index_ref": {"$ref": "#/definitions/ref"},
    "attachment_package_ref": {"$ref": "#/definitions/resource_ref"},
    "prompt_authority_refs": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/definitions/ref"}, "uniqueItems": true},
    "tool_catalog_ref": {"$ref": "#/definitions/resource_ref"},
    "experiment_config": {"type": "object"},
    "environment_ref": {"$ref": "#/definitions/ref"},
    "numerical_profile_ref": {"$ref": "#/definitions/ref"},
    "logical_request_policy_ref": {"$ref": "#/definitions/ref"}
  },
  "required": ["registered_run_inputs_ref", "raw_task_ref", "initial_workspace_ref", "external_resource_index_ref", "prompt_authority_refs", "tool_catalog_ref", "experiment_config", "environment_ref", "numerical_profile_ref", "logical_request_policy_ref"]
}
