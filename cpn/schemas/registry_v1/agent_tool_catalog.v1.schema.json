{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/agent_tool_catalog/v1",
  "title": "Current parent-owned agent-tool surface",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "agent_tool_catalog/v1"},
    "surface_kind": {"const": "parent_current"},
    "workspace_scope": {"const": "firing_private_projection"},
    "tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "description": {"type": "string", "minLength": 1},
          "arguments": {"type": "object"}
        },
        "required": ["name", "description", "arguments"]
      }
    }
  },
  "required": ["schema_version", "surface_kind", "workspace_scope", "tools"]
}
