{
  "$id": "registry_v1/task/v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task_id": {"type": "string", "pattern": "^task:[a-f0-9]{32}$"},
    "task_version_id": {"type": "string", "pattern": "^task_version:[a-f0-9]{32}$"}
  },
  "required": ["task_id", "task_version_id"]
}
