{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/operation_result/v1",
  "title": "Completed operation result",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {"type": "object", "additionalProperties": false, "properties": {"entity_type": {"type": "string"}, "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}, "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}}, "required": ["entity_type", "logical_id", "version_id"]},
    "nullable_ref": {"oneOf": [{"$ref": "#/definitions/ref"}, {"type": "null"}]}
  },
  "properties": {
    "operation_result_ref": {"$ref": "#/definitions/ref"},
    "invocation_ref": {"$ref": "#/definitions/ref"},
    "transition_firing_ref": {"$ref": "#/definitions/ref"},
    "business_outcome": {"const": "completed"},
    "output_resource_refs": {"type": "array", "items": {"$ref": "#/definitions/ref"}, "uniqueItems": true},
    "provider_attempt_evidence_refs": {"type": "array", "items": {"$ref": "#/definitions/ref"}, "uniqueItems": true},
    "workspace_access_set_ref": {"$ref": "#/definitions/nullable_ref"}
  },
  "required": ["operation_result_ref", "invocation_ref", "transition_firing_ref", "business_outcome", "output_resource_refs", "provider_attempt_evidence_refs", "workspace_access_set_ref"]
}
