{
  "$id": "registry_v1/generic_critic_prompt/v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generic critic neutral request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "model_condition": {
      "type": "string",
      "minLength": 1
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": ["system", "user", "assistant", "tool"]
          },
          "content": {
            "type": "string"
          }
        },
        "required": ["role", "content"]
      }
    }
  },
  "required": ["model_condition", "max_output_tokens", "messages"]
}
