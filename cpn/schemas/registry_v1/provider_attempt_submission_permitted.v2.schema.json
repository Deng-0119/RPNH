{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/provider_attempt_submission_permitted/v2",
  "title": "provider_attempt_submission_permitted/v2",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {"type":"object","additionalProperties":false,"properties":{"entity_type":{"type":"string"},"logical_id":{"type":"string","pattern":"^[a-z][a-z0-9_]*:[a-f0-9]{32}$"},"version_id":{"type":"string","pattern":"^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}},"required":["entity_type","logical_id","version_id"]}
  },
  "properties": {
    "provider_attempt_id": {"type": "string", "pattern": "^provider_attempt:[a-f0-9]{32}$"},
    "provider_attempt_version_id": {"type": "string", "pattern": "^provider_attempt_version:[a-f0-9]{32}$"},
    "provider_attempt_ref": {"$ref": "#/definitions/ref"},
    "llm_call_ref": {"$ref": "#/definitions/ref"},
    "invocation_ref": {"$ref": "#/definitions/ref"},
    "operation_execution_lease_ref": {"$ref": "#/definitions/ref"},
    "operation_start_event_id": {"type": "string", "pattern": "^event:[a-f0-9]{32}$"},
    "dispatch_event_id": {"type": "string", "pattern": "^event:[a-f0-9]{32}$"},
    "lifecycle_observation_event_id": {"type": "string", "pattern": "^event:[a-f0-9]{32}$"},
    "evidence_receipt_id": {"type": ["string", "null"], "pattern": "^rct_[a-f0-9]{32}$"},
    "request_payload_byte_count": {"type": "integer", "minimum": 1},
    "response_protocol": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+/v[1-9][0-9]*$", "maxLength": 160},
    "state": {"const": "submission_permitted"}
  },
  "required": ["provider_attempt_id", "provider_attempt_version_id", "provider_attempt_ref", "llm_call_ref", "invocation_ref", "operation_execution_lease_ref", "operation_start_event_id", "dispatch_event_id", "lifecycle_observation_event_id", "evidence_receipt_id", "request_payload_byte_count", "response_protocol", "state"]
}
