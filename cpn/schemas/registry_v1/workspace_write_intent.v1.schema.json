{
  "$id": "registry_v1/workspace_write_intent/v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "operation_binding_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "operation_binding/v1"},
        "logical_id": {"type": "string", "pattern": "^operation_binding:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^operation_binding_version:[a-f0-9]{32}$"}
      },
      "required": ["entity_type", "logical_id", "version_id"]
    },
    "workspace_binding_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "workspace_binding/v1"},
        "logical_id": {"type": "string", "pattern": "^workspace_binding:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^workspace_binding_version:[a-f0-9]{32}$"}
      },
      "required": ["entity_type", "logical_id", "version_id"]
    }
  },
  "properties": {
    "write_intent_id": {"type": "string", "pattern": "^write_intent:[a-f0-9]{32}$"},
    "write_intent_version_id": {"type": "string", "pattern": "^write_intent_version:[a-f0-9]{32}$"},
    "operation_binding_ref": {"$ref": "#/definitions/operation_binding_ref"},
    "source_binding_ref": {"$ref": "#/definitions/workspace_binding_ref"},
    "allowed_relative_root": {"type": "string"},
    "one_lineage": {"const": true}
  },
  "required": [
    "write_intent_id", "write_intent_version_id", "operation_binding_ref",
    "source_binding_ref", "allowed_relative_root", "one_lineage"
  ]
}
