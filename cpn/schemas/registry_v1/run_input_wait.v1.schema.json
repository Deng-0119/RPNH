{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/run_input_wait/v1",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_type": {
          "type": "string"
        },
        "logical_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"
        },
        "version_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"
        }
      },
      "required": [
        "entity_type",
        "logical_id",
        "version_id"
      ]
    }
  },
  "properties": {
    "self_ref": {
      "$ref": "#/definitions/ref"
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_session_ref": {
      "$ref": "#/definitions/ref"
    },
    "task_ref": {
      "$ref": "#/definitions/ref"
    },
    "run_ref": {
      "$ref": "#/definitions/ref"
    },
    "net_ref": {
      "$ref": "#/definitions/ref"
    },
    "source_ref": {
      "$ref": "#/definitions/ref"
    },
    "predecessor_checkpoint_ref": {
      "$ref": "#/definitions/ref"
    },
    "checkpoint_ref": {
      "$ref": "#/definitions/ref"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transition_id": {
          "type": "string",
          "minLength": 1
        },
        "input_port": {
          "type": "string",
          "minLength": 1
        },
        "anchor_token_ref": {
          "$ref": "#/definitions/ref"
        },
        "binding_ref": {
          "$ref": "#/definitions/ref"
        },
        "allowed_principal_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/ref"
          }
        },
        "expires_at_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "expiry_input": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "schema_id": {
                  "type": "string",
                  "minLength": 1
                },
                "payload": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                }
              },
              "required": [
                "schema_id",
                "payload",
                "summary"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "supersedes_wait_ref": {
          "oneOf": [
            {
              "$ref": "#/definitions/ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "transition_id",
        "input_port",
        "anchor_token_ref",
        "binding_ref",
        "allowed_principal_refs",
        "expires_at_utc",
        "expiry_input",
        "supersedes_wait_ref"
      ]
    }
  },
  "required": [
    "self_ref",
    "command_id",
    "owner_session_ref",
    "task_ref",
    "run_ref",
    "net_ref",
    "source_ref",
    "predecessor_checkpoint_ref",
    "checkpoint_ref",
    "spec"
  ]
}
