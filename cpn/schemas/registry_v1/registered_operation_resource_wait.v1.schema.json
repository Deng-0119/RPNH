    "same_firing_continuation": {"const": true}
  },
  "required": ["transition_firing_ref", "invocation_ref", "operation_execution_lease_ref", "operation_binding_ref", "agent_loop_ref", "agent_turn_ref", "agent_action_ref", "resource_access_lifecycle_ref", "queue_entry_id", "state", "same_firing_continuation"]
