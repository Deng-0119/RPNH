{
  "$id": "registry_v1/task_round/v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
    "predecessor_task_round_id": {
      "pattern": "^task_round:[a-f0-9]{32}$",
      "type": [
        "string",
        "null"
      ]
    },
    "round_number": {
      "minimum": 1,
      "type": "integer"
    },
    "task_id": {
      "pattern": "^task:[a-f0-9]{32}$",
      "type": "string"
    },
    "task_round_id": {
      "pattern": "^task_round:[a-f0-9]{32}$",
      "type": "string"
    }
  },
  "required": [
    "task_round_id",
    "task_id",
    "round_number",
    "predecessor_task_round_id"
  ],
  "title": "task_round/v1",
  "type": "object"
}
