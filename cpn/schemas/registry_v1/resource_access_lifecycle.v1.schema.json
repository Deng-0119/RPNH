{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/resource_access_lifecycle/v1",
  "title": "Resource RW request, queue, heartbeat, grant, resume, release, and cleanup",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {"type": "object", "additionalProperties": false, "properties": {"entity_type": {"type": "string"}, "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}, "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}}, "required": ["entity_type", "logical_id", "version_id"]},
    "nullable_ref": {"oneOf": [{"$ref": "#/definitions/ref"}, {"type": "null"}]},
    "queue_entry": {"type": "object", "additionalProperties": false, "properties": {"queue_entry_ref": {"$ref": "#/definitions/ref"}, "request_ref": {"$ref": "#/definitions/ref"}, "transition_firing_ref": {"$ref": "#/definitions/ref"}, "invocation_ref": {"$ref": "#/definitions/ref"}, "mode": {"enum": ["read", "edit", "upgrade"]}, "ordinal": {"type": "integer", "minimum": 0}, "writer_fencing_epoch": {"type": "integer", "minimum": 1}}, "required": ["queue_entry_ref", "request_ref", "transition_firing_ref", "invocation_ref", "mode", "ordinal", "writer_fencing_epoch"]}
  },
  "properties": {
    "lifecycle_ref": {"$ref": "#/definitions/ref"},
    "request_ref": {"$ref": "#/definitions/ref"},
    "queue_entry_ref": {"$ref": "#/definitions/nullable_ref"},
    "heartbeat_ref": {"$ref": "#/definitions/nullable_ref"},
    "grant_ref": {"$ref": "#/definitions/nullable_ref"},
    "resume_ref": {"$ref": "#/definitions/nullable_ref"},
    "release_ref": {"$ref": "#/definitions/nullable_ref"},
    "cleanup_ref": {"$ref": "#/definitions/nullable_ref"},
    "transition_firing_ref": {"$ref": "#/definitions/ref"},
    "transition_id": {"type": "string", "minLength": 1},
    "invocation_ref": {"$ref": "#/definitions/ref"},
    "operation_execution_lease_ref": {"$ref": "#/definitions/ref"},
    "operation_binding_ref": {"$ref": "#/definitions/ref"},
    "agent_loop_ref": {"$ref": "#/definitions/ref"},
    "agent_turn_ref": {"$ref": "#/definitions/ref"},
    "agent_action_ref": {"$ref": "#/definitions/ref"},
    "requester_agent_ref": {"$ref": "#/definitions/ref"},
    "logical_resource_id": {"type": "string", "pattern": "^resource:[a-f0-9]{32}$"},
    "lock_resource_ref": {"$ref": "#/definitions/ref"},
    "requested_resource_ref": {"$ref": "#/definitions/nullable_ref"},
    "llm_turns_used": {"type": "integer", "minimum": 1},
    "access_checkpoint_ref": {"$ref": "#/definitions/ref"},
    "access_net_ref": {"$ref": "#/definitions/ref"},
    "access_claim_epoch": {"type": "integer", "minimum": 0},
    "resource_token_ref": {"$ref": "#/definitions/ref"},
    "lease_pool_place": {"type": "string", "minLength": 1},
    "lease_identity_ref": {"$ref": "#/definitions/ref"},
    "petri_input_arc_mode": {"enum": ["read", "borrow"]},
    "petri_output_arc_mode": {"enum": ["return", null]},
    "petri_arc_kind": {"enum": ["read", "borrow"]},
    "return_arc_required": {"type": "boolean"},
    "same_firing_continuation": {"const": true},
    "mode": {"enum": ["read", "edit", "upgrade"]},
    "state": {"enum": ["requested", "queued", "waiting_resource", "granted", "resumed", "released", "cleaned", "sealed"]},
    "stable_queue": {"type": "array", "items": {"$ref": "#/definitions/queue_entry"}, "uniqueItems": true},
    "queue_policy": {"const": "no_reader_barging_past_writer_or_upgrade"},
    "writer_fencing_epoch": {"type": "integer", "minimum": 1},
    "heartbeat_at_utc": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "lease_ref": {"$ref": "#/definitions/nullable_ref"},
    "wake_reason": {"oneOf": [{"enum": ["lock_compatible", "owner_stop", "firing_settled", "firing_faulted", "firing_abandoned", "lease_expired", "request_cancelled"]}, {"type": "null"}]},
    "resource_cycle_evidence_ref": {"$ref": "#/definitions/nullable_ref"},
    "resource_wait_started_at_utc": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "resource_wait_started_monotonic": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "resource_wait_started_monotonic_segment_id": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "resource_wait_ended_at_utc": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "resource_wait_ended_monotonic": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "resource_wait_ended_monotonic_segment_id": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "blocked_started_at_utc": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "blocked_started_monotonic": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "blocked_started_monotonic_segment_id": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "blocked_ended_at_utc": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "blocked_ended_monotonic": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
    "blocked_ended_monotonic_segment_id": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "seal_ref": {"$ref": "#/definitions/nullable_ref"},
    "settlement_ref": {"$ref": "#/definitions/nullable_ref"},
    "settlement_disposition": {"oneOf": [{"enum": ["success", "fault", "abandon"]}, {"type": "null"}]}
  },
  "required": ["lifecycle_ref", "request_ref", "queue_entry_ref", "heartbeat_ref", "grant_ref", "resume_ref", "release_ref", "cleanup_ref", "transition_firing_ref", "transition_id", "invocation_ref", "operation_execution_lease_ref", "operation_binding_ref", "agent_loop_ref", "agent_turn_ref", "agent_action_ref", "requester_agent_ref", "logical_resource_id", "lock_resource_ref", "requested_resource_ref", "llm_turns_used", "access_checkpoint_ref", "access_net_ref", "access_claim_epoch", "resource_token_ref", "lease_pool_place", "lease_identity_ref", "petri_input_arc_mode", "petri_output_arc_mode", "petri_arc_kind", "return_arc_required", "same_firing_continuation", "mode", "state", "stable_queue", "queue_policy", "writer_fencing_epoch", "heartbeat_at_utc", "lease_ref", "wake_reason", "resource_cycle_evidence_ref", "resource_wait_started_at_utc", "resource_wait_started_monotonic", "resource_wait_started_monotonic_segment_id", "resource_wait_ended_at_utc", "resource_wait_ended_monotonic", "resource_wait_ended_monotonic_segment_id", "blocked_started_at_utc", "blocked_started_monotonic", "blocked_started_monotonic_segment_id", "blocked_ended_at_utc", "blocked_ended_monotonic", "blocked_ended_monotonic_segment_id", "seal_ref", "settlement_ref", "settlement_disposition"],
  "allOf": [
    {"if": {"properties": {"state": {"enum": ["queued", "waiting_resource", "granted", "resumed", "released", "cleaned"]}}}, "then": {"properties": {"queue_entry_ref": {"$ref": "#/definitions/ref"}}}},
    {"if": {"properties": {"state": {"enum": ["waiting_resource", "granted", "resumed", "released", "cleaned"]}}}, "then": {"properties": {"heartbeat_ref": {"$ref": "#/definitions/ref"}, "heartbeat_at_utc": {"type": "string", "format": "date-time"}}}},
    {"if": {"properties": {"state": {"enum": ["granted", "resumed", "released", "cleaned"]}}}, "then": {"properties": {"grant_ref": {"$ref": "#/definitions/ref"}, "lease_ref": {"$ref": "#/definitions/ref"}}}},
    {"if": {"properties": {"state": {"const": "waiting_resource"}}}, "then": {"properties": {"wake_reason": {"type": "null"}}}},
    {"if": {"properties": {"state": {"enum": ["granted", "resumed", "released", "cleaned"]}}}, "then": {"properties": {"wake_reason": {"enum": ["lock_compatible", "owner_stop", "firing_settled", "firing_faulted", "firing_abandoned", "lease_expired", "request_cancelled"]}}}},
    {"if": {"properties": {"state": {"enum": ["resumed", "released", "cleaned"]}}}, "then": {"properties": {"resume_ref": {"$ref": "#/definitions/ref"}}}},
    {"if": {"properties": {"state": {"enum": ["released", "cleaned"]}}}, "then": {"properties": {"release_ref": {"$ref": "#/definitions/ref"}}}},
    {"if": {"properties": {"state": {"const": "cleaned"}}}, "then": {"properties": {"cleanup_ref": {"$ref": "#/definitions/ref"}}}},
    {"if": {"properties": {"state": {"const": "sealed"}}}, "then": {"properties": {"seal_ref": {"$ref": "#/definitions/ref"}, "settlement_ref": {"$ref": "#/definitions/ref"}, "settlement_disposition": {"enum": ["success", "fault", "abandon"]}}}},
    {"if": {"properties": {"mode": {"const": "read"}}}, "then": {"properties": {"petri_input_arc_mode": {"const": "read"}, "petri_output_arc_mode": {"type": "null"}, "petri_arc_kind": {"const": "read"}, "return_arc_required": {"const": false}}}},
    {"if": {"properties": {"mode": {"enum": ["edit", "upgrade"]}}}, "then": {"properties": {"petri_input_arc_mode": {"const": "borrow"}, "petri_output_arc_mode": {"const": "return"}, "petri_arc_kind": {"const": "borrow"}, "return_arc_required": {"const": true}}}}
  ]
}
