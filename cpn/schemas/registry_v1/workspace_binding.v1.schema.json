{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/workspace_binding/v1",
  "title": "RPNH workspace lineage template or firing view",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_type": {"type": "string"},
        "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}
      },
      "required": ["entity_type", "logical_id", "version_id"]
    },
    "nullable_ref": {
      "oneOf": [{"$ref": "#/definitions/ref"}, {"type": "null"}]
    },
    "resource_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_id": {"type": "string", "pattern": "^resource:[a-f0-9]{32}$"},
        "resource_version_id": {"type": "string", "pattern": "^resource_version:[a-f0-9]{32}$"}
      },
      "required": ["resource_id", "resource_version_id"]
    },
    "nullable_resource_ref": {
      "oneOf": [{"$ref": "#/definitions/resource_ref"}, {"type": "null"}]
    }
  },
  "properties": {
    "workspace_binding_id": {"type": "string", "pattern": "^workspace_binding:[a-f0-9]{32}$"},
    "workspace_binding_version_id": {"type": "string", "pattern": "^workspace_binding_version:[a-f0-9]{32}$"},
    "operation_binding_ref": {"$ref": "#/definitions/ref"},
    "binding_kind": {"enum": ["lineage_template", "firing_view"]},
    "workspace_lineage_ref": {"$ref": "#/definitions/ref"},
    "base_revision_ref": {"$ref": "#/definitions/ref"},
    "template_binding_ref": {"$ref": "#/definitions/nullable_ref"},
    "invocation_ref": {"$ref": "#/definitions/nullable_ref"},
    "transition_firing_ref": {"$ref": "#/definitions/nullable_ref"},
    "allowed_root": {"type": "string", "minLength": 1},
    "allowed_prefixes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "mode": {"const": "read_write"},
    "workspace_seed_manifest_ref": {"$ref": "#/definitions/nullable_resource_ref"},
    "workspace_runtime_ref": {"$ref": "#/definitions/nullable_resource_ref"}
  },
  "required": [
    "workspace_binding_id", "workspace_binding_version_id",
    "operation_binding_ref", "binding_kind", "workspace_lineage_ref",
    "base_revision_ref", "template_binding_ref", "invocation_ref",
    "transition_firing_ref", "allowed_root", "allowed_prefixes", "mode",
    "workspace_seed_manifest_ref", "workspace_runtime_ref"
  ],
  "allOf": [
    {
      "if": {"properties": {"binding_kind": {"const": "lineage_template"}}},
      "then": {
        "properties": {
          "template_binding_ref": {"type": "null"},
          "invocation_ref": {"type": "null"},
          "transition_firing_ref": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "template_binding_ref": {"$ref": "#/definitions/ref"},
          "invocation_ref": {"$ref": "#/definitions/ref"},
          "transition_firing_ref": {"$ref": "#/definitions/ref"}
        }
      }
    }
  ]
}
