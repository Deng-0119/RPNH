{
  "$id": "registry_v1/task_branch/v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"type": "string"},
        "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}
      },
      "required": ["entity_type", "logical_id", "version_id"]
    }
  },
  "properties": {
    "task_branch_id": {"type": "string", "pattern": "^task_branch:[a-f0-9]{32}$"},
    "task_branch_version_id": {"type": "string", "pattern": "^task_branch_version:[a-f0-9]{32}$"},
    "task_ref": {"$ref": "#/definitions/ref"},
    "branch_name": {"type": "string", "minLength": 1}
  },
  "required": ["task_branch_id", "task_branch_version_id", "task_ref", "branch_name"]
}
