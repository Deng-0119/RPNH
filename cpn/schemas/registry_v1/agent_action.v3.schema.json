  "required":["agent_action_id","agent_action_version_id","agent_action_ref","agent_loop_ref","agent_turn_ref","turn_sequence","tool_call_ordinal","tool_call_id","action_identity_kind","action_identity_key","tool_name","raw_arguments","arguments","expected_revision","state","result_refs","tool_error_ref","provider_name","registration_key","selector","plugin_catalog_digest","binding_digest","effect","outcome","request_admission_receipt_ref","admitted_at_utc","started_receipt_ref","terminal_receipt_ref","model_visible_result_ref","non_delivery_reason","output","error","max_result_bytes","output_size_bytes","error_size_bytes"],
  "allOf":[
    {"if":{"properties":{"outcome":{"const":"returned"}}},"then":{"properties":{"state":{"const":"ACTION_APPLIED"},"request_admission_receipt_ref":{"$ref":"#/definitions/resource_ref"},"admitted_at_utc":{"type":"string"},"started_receipt_ref":{"$ref":"#/definitions/resource_ref"},"terminal_receipt_ref":{"$ref":"#/definitions/resource_ref"},"model_visible_result_ref":{"type":"null"},"non_delivery_reason":{"const":"provider_delivery_not_recorded"},"error":{"type":"null"},"error_size_bytes":{"const":0},"tool_error_ref":{"type":"null"}}}},
    {"if":{"properties":{"outcome":{"const":"failed"}}},"then":{"properties":{"state":{"const":"ACTION_REJECTED"},"request_admission_receipt_ref":{"$ref":"#/definitions/resource_ref"},"admitted_at_utc":{"type":"string"},"started_receipt_ref":{"$ref":"#/definitions/resource_ref"},"terminal_receipt_ref":{"$ref":"#/definitions/resource_ref"},"model_visible_result_ref":{"type":"null"},"non_delivery_reason":{"const":"managed_call_failed"},"output":{"type":"null"},"output_size_bytes":{"const":0},"error":{"not":{"type":"null"}},"tool_error_ref":{"$ref":"#/definitions/ref"}}}},
    {"if":{"properties":{"outcome":{"const":"outcome_unknown"}}},"then":{"properties":{"state":{"const":"ACTION_REJECTED"},"request_admission_receipt_ref":{"$ref":"#/definitions/resource_ref"},"admitted_at_utc":{"type":"string"},"started_receipt_ref":{"$ref":"#/definitions/resource_ref"},"terminal_receipt_ref":{"$ref":"#/definitions/resource_ref"},"model_visible_result_ref":{"type":"null"},"non_delivery_reason":{"const":"outcome_unknown"},"output":{"type":"null"},"output_size_bytes":{"const":0},"error":{"not":{"type":"null"}},"tool_error_ref":{"$ref":"#/definitions/ref"}}}},
    {"if":{"properties":{"outcome":{"const":"rejected"}}},"then":{"properties":{"state":{"const":"ACTION_REJECTED"},"request_admission_receipt_ref":{"type":"null"},"admitted_at_utc":{"type":"null"},"started_receipt_ref":{"type":"null"},"terminal_receipt_ref":{"type":"null"},"model_visible_result_ref":{"type":"null"},"non_delivery_reason":{"const":"rejected_before_dispatch"},"output":{"type":"null"},"output_size_bytes":{"const":0},"error":{"not":{"type":"null"}},"tool_error_ref":{"$ref":"#/definitions/ref"}}}}
