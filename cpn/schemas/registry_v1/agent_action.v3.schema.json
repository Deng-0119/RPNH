    "max_result_bytes":{"type":"integer","minimum":1,"maximum":16777216},
    "output_size_bytes":{"type":"integer","minimum":0,"maximum":16777216},
    "error_size_bytes":{"type":"integer","minimum":0,"maximum":65536}
