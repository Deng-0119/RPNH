{
  "$id": "registry_v1/observed_read/v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "task_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "task/v1"},
        "logical_id": {"type": "string", "pattern": "^task:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^task_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "task_branch_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "task_branch/v1"},
        "logical_id": {"type": "string", "pattern": "^task_branch:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^task_branch_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "task_round_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "task_round/v1"},
        "logical_id": {"type": "string", "pattern": "^task_round:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^task_round_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "net_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "net_instance/v1"},
        "logical_id": {"type": "string", "pattern": "^net_instance:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^net_instance_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "invocation_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "invocation/v1"},
        "logical_id": {"type": "string", "pattern": "^invocation:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^invocation_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "node_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "node_declaration/v1"},
        "logical_id": {"type": "string", "pattern": "^node:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^node_declaration_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "firing_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "transition_firing/v1"},
        "logical_id": {"type": "string", "pattern": "^transition_firing:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^transition_firing_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "activation_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "a2c_activation/v1"},
        "logical_id": {"type": "string", "pattern": "^a2c_activation:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^a2c_activation_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "resource_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "resource_id": {"type": "string", "pattern": "^resource:[a-f0-9]{32}$"},
        "resource_version_id": {"type": "string", "pattern": "^resource_version:[a-f0-9]{32}$"}
      }, "required": ["resource_id", "resource_version_id"]
    },
    "operation_binding_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "operation_binding/v1"},
        "logical_id": {"type": "string", "pattern": "^operation_binding:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^operation_binding_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "capability_grant_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "capability_grant/v1"},
        "logical_id": {"type": "string", "pattern": "^grant:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^grant:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "authorization_ref": {"oneOf": [
      {"$ref": "#/definitions/operation_binding_ref"},
      {"$ref": "#/definitions/capability_grant_ref"}
    ]},
    "witness_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "resource_release_witness/v1"},
        "logical_id": {"type": "string", "pattern": "^release_witness:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^release_witness_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "boundary_receipt_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "delivery_boundary_receipt/v1"},
        "logical_id": {"type": "string", "pattern": "^boundary_receipt:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^boundary_receipt_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    }
  },
  "properties": {
    "origin": {"const": "petri_operation"},
    "task_ref": {"$ref": "#/definitions/task_ref"},
    "task_branch_ref": {"$ref": "#/definitions/task_branch_ref"},
    "task_round_ref": {"$ref": "#/definitions/task_round_ref"},
    "net_ref": {"$ref": "#/definitions/net_ref"},
    "actor_invocation_ref": {"$ref": "#/definitions/invocation_ref"},
    "accounting_parent_ref": {"$ref": "#/definitions/invocation_ref"},
    "node_ref": {"oneOf": [{"$ref": "#/definitions/node_ref"}, {"type": "null"}]},
    "firing_ref": {"$ref": "#/definitions/firing_ref"},
    "activation_ref": {"oneOf": [{"$ref": "#/definitions/activation_ref"}, {"type": "null"}]},
    "resource_ref": {"$ref": "#/definitions/resource_ref"},
    "resource_byte_count": {"type": "integer", "minimum": 0},
    "authorization_ref": {"$ref": "#/definitions/authorization_ref"},
    "witness_ref": {"$ref": "#/definitions/witness_ref"},
    "boundary_receipt_ref": {"$ref": "#/definitions/boundary_receipt_ref"},
    "delivery_id": {"type": "string", "pattern": "^resource_delivery:[a-f0-9]{32}$"},
    "transaction_id": {"type": "string", "pattern": "^transaction:[a-f0-9]{32}$"},
    "boundary": {"enum": ["llm_prompt", "tool_result", "subprocess_read", "parent_receipt", "petri_input"]}
  },
  "required": [
    "origin", "task_ref", "task_branch_ref", "task_round_ref", "net_ref",
    "actor_invocation_ref", "accounting_parent_ref", "node_ref", "firing_ref",
    "resource_ref", "resource_byte_count",
    "authorization_ref", "witness_ref", "boundary_receipt_ref", "delivery_id",
    "transaction_id", "boundary"
  ],
  "allOf": [{"properties": {
    "node_ref": {"$ref": "#/definitions/node_ref"}
  }}]
}
