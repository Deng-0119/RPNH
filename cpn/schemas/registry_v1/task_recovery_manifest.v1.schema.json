{
  "$id": "registry_v1/task_recovery_manifest/v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "budget_buckets": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "properties": {"bucket_id": {"type": "string", "minLength": 1}, "budget_scope": {"type": "string", "minLength": 1}, "finalization_scope": {"type": ["string", "null"], "minLength": 1}, "max_attempts": {"type": ["integer", "null"], "minimum": 1}}, "required": ["bucket_id", "budget_scope", "finalization_scope", "max_attempts"]}},
    "branch_id": {
      "minLength": 1,
      "type": "string"
    },
    "failure_reviewer_a_max_leaf_delegations": {
      "minimum": 0,
      "type": "integer"
    },
    "failure_reviewer_a_max_llm_attempts_per_leaf": {
      "minimum": 0,
      "type": "integer"
    },
    "failure_reviewer_a_own_max_attempts": {
      "minimum": 1,
      "type": "integer"
    },
    "failure_reviewer_a_retry_limit": {
      "minimum": 0,
      "type": "integer"
    },
    "failure_reviewer_a_tool_turn_limit": {
      "minimum": 0,
      "type": "integer"
    },
    "failure_reviewer_a_total_max_attempts": {
      "minimum": 1,
      "type": "integer"
    },
    "failure_reviewer_b_max_leaf_delegations": {
      "minimum": 0,
      "type": "integer"
    },
    "failure_reviewer_b_max_llm_attempts_per_leaf": {
      "minimum": 0,
      "type": "integer"
    },
    "failure_reviewer_b_own_max_attempts": {
      "minimum": 1,
      "type": "integer"
    },
    "failure_reviewer_b_retry_limit": {
      "minimum": 0,
      "type": "integer"
    },
    "failure_reviewer_b_tool_turn_limit": {
      "minimum": 0,
      "type": "integer"
    },
    "failure_reviewer_b_total_max_attempts": {
      "minimum": 1,
      "type": "integer"
    },
    "finalization_budget": {
      "minimum": 0,
      "type": "integer"
    },
    "host_resource_inventory_ref": {
      "pattern": "^resource_version:[a-f0-9]{32}$",
      "type": "string"
    },
    "inventory_schema_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:/[a-z][a-z0-9_]*)+/v[1-9][0-9]*$"
    },
    "ordinary_global_cap": {
      "minimum": 1,
      "type": ["integer", "null"]
    },
    "protocol_versions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "task_id": {
      "pattern": "^task:[a-f0-9]{32}$",
      "type": "string"
    },
    "task_total_hard_cap": {
      "minimum": 1,
      "type": ["integer", "null"]
    },
    "terminal_quota": {
      "minimum": 0,
      "type": "integer"
    },
    "writer_fencing_epoch": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "budget_buckets",
    "task_id",
    "branch_id",
    "protocol_versions",
    "host_resource_inventory_ref",
    "inventory_schema_id",
    "writer_fencing_epoch",
    "ordinary_global_cap",
    "terminal_quota",
    "task_total_hard_cap",
    "finalization_budget"
  ],
  "title": "task_recovery_manifest/v1",
  "type": "object"
}
