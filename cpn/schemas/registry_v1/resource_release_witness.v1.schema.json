{
  "$id": "registry_v1/resource_release_witness/v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "delivery_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "resource_delivery/v1"},
        "logical_id": {"type": "string", "pattern": "^resource_delivery:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^resource_delivery_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "resource_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "resource_id": {"type": "string", "pattern": "^resource:[a-f0-9]{32}$"},
        "resource_version_id": {"type": "string", "pattern": "^resource_version:[a-f0-9]{32}$"}
      }, "required": ["resource_id", "resource_version_id"]
    },
    "operation_binding_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "operation_binding/v1"},
        "logical_id": {"type": "string", "pattern": "^operation_binding:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^operation_binding_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "capability_grant_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "capability_grant/v1"},
        "logical_id": {"type": "string", "pattern": "^grant:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^grant:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "authorization_ref": {"oneOf": [
      {"$ref": "#/definitions/operation_binding_ref"},
      {"$ref": "#/definitions/capability_grant_ref"}
    ]},
    "invocation_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "invocation/v1"},
        "logical_id": {"type": "string", "pattern": "^invocation:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^invocation_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "authority_head": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "writer_fencing_epoch": {"type": "integer", "minimum": 1},
        "task_control_sequence": {"type": "integer", "minimum": 0},
        "stream_heads": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      },
      "required": ["ordinal", "writer_fencing_epoch", "task_control_sequence", "stream_heads"]
    }
  },
  "properties": {
    "witness_id": {"type": "string", "pattern": "^release_witness:[a-f0-9]{32}$"},
    "witness_version_id": {"type": "string", "pattern": "^release_witness_version:[a-f0-9]{32}$"},
    "delivery_ref": {"$ref": "#/definitions/delivery_ref"},
    "resource_ref": {"$ref": "#/definitions/resource_ref"},
    "resource_byte_count": {"type": "integer", "minimum": 0},
    "boundary": {"enum": ["llm_prompt", "tool_result", "subprocess_read", "parent_receipt", "petri_input"]},
    "context_ref": {"$ref": "#/definitions/invocation_ref"},
    "accounting_parent_ref": {"$ref": "#/definitions/invocation_ref"},
    "authorization_ref": {"$ref": "#/definitions/authorization_ref"},
    "release_nonce": {"type": "string", "pattern": "^release_nonce:[a-f0-9]{32}$"},
    "authority_head": {"$ref": "#/definitions/authority_head"},
    "expires_at": {"type": "string", "minLength": 1},
    "consumed": {"const": false},
    "outcome": {"type": "null"},
    "command_identity": {"type": "string", "minLength": 1}
  },
  "required": [
    "witness_id", "witness_version_id", "delivery_ref", "resource_ref", "resource_byte_count",
    "boundary", "context_ref", "accounting_parent_ref", "authorization_ref", "release_nonce",
    "authority_head", "expires_at", "consumed", "outcome", "command_identity"
  ]
}
