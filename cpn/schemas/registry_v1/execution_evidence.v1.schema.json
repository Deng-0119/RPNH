{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/execution_evidence/v1",
  "title": "Auditable execution evidence closure",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {"type": "object", "additionalProperties": false, "properties": {"entity_type": {"type": "string"}, "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}, "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}}, "required": ["entity_type", "logical_id", "version_id"]},
    "refs": {"type": "array", "items": {"$ref": "#/definitions/ref"}, "uniqueItems": true},
    "nullable_ref": {"oneOf": [{"$ref": "#/definitions/ref"}, {"type": "null"}]}
  },
  "properties": {
    "execution_evidence_ref": {"$ref": "#/definitions/ref"},
    "run_ref": {"$ref": "#/definitions/ref"},
    "prompt_authority_refs": {"$ref": "#/definitions/refs"},
    "tool_catalog_refs": {"$ref": "#/definitions/refs"},
    "kb_access_refs": {"$ref": "#/definitions/refs"},
    "environment_refs": {"$ref": "#/definitions/refs"},
    "numerical_profile_refs": {"$ref": "#/definitions/refs"},
    "llm_invocation_attempt_refs": {"$ref": "#/definitions/refs"},
    "firing_timing_refs": {"$ref": "#/definitions/refs"},
    "checkpoint_refs": {"$ref": "#/definitions/refs"},
    "terminal_evidence_ref": {"$ref": "#/definitions/nullable_ref"},
    "experiment_result_ref": {"$ref": "#/definitions/nullable_ref"},
    "execution_status": {"enum": ["RUNNING", "COMPLETED", "FAILED", "CANCELLED", "UNCERTAIN", "UNSCORED_LLM_INTERRUPTED", "STOPPED_BY_OWNER", "BLOCKED"]}
  },
  "required": ["execution_evidence_ref", "run_ref", "prompt_authority_refs", "tool_catalog_refs", "kb_access_refs", "environment_refs", "numerical_profile_refs", "llm_invocation_attempt_refs", "firing_timing_refs", "checkpoint_refs", "terminal_evidence_ref", "experiment_result_ref", "execution_status"]
}
