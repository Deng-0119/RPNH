{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/collaboration_net_revision/v2",
  "title": "Immutable ordinary-v3 graph source author revision",
  "description": "Explicit graph source and frozen recipe authority. No Branch, Assembly or runtime adoption authority.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "revision_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/source_version_ref/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entity_type": {
              "const": "collaboration_net_revision/v2"
            },
            "logical_id": {
              "type": "string",
              "pattern": "^resource:[a-f0-9]{32}(?![\\s\\S])"
            },
            "version_id": {
              "type": "string",
              "pattern": "^resource_version:[a-f0-9]{32}(?![\\s\\S])"
            }
          },
          "required": [
            "entity_type",
            "logical_id",
            "version_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "ref"
      ]
    },
    "task_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/source_version_ref/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entity_type": {
              "const": "task/v1"
            },
            "logical_id": {
              "type": "string",
              "pattern": "^task:[a-f0-9]{32}(?![\\s\\S])"
            },
            "version_id": {
              "type": "string",
              "pattern": "^task_version:[a-f0-9]{32}(?![\\s\\S])"
            }
          },
          "required": [
            "entity_type",
            "logical_id",
            "version_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "ref"
      ]
    },
    "principal_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/source_version_ref/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entity_type": {
              "const": "principal/v1"
            },
            "logical_id": {
              "type": "string",
              "pattern": "^principal:[a-f0-9]{32}(?![\\s\\S])"
            },
            "version_id": {
              "type": "string",
              "pattern": "^principal_version:[a-f0-9]{32}(?![\\s\\S])"
            }
          },
          "required": [
            "entity_type",
            "logical_id",
            "version_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "ref"
      ]
    },
    "resource_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/source_resource_ref/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resource_id": {
              "type": "string",
              "pattern": "^resource:[a-f0-9]{32}(?![\\s\\S])"
            },
            "resource_version_id": {
              "type": "string",
              "pattern": "^resource_version:[a-f0-9]{32}(?![\\s\\S])"
            }
          },
          "required": [
            "resource_id",
            "resource_version_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "ref"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "const": "registry_v1/collaboration_net_revision/v2"
    },
    "revision_ref": {
      "$ref": "#/definitions/revision_ref"
    },
    "owner_task_ref": {
      "$ref": "#/definitions/task_ref"
    },
    "producer_principal_ref": {
      "$ref": "#/definitions/principal_ref"
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
    },
    "definition_kind": {
      "const": "closed_module"
    },
    "definition_ref": {
      "$ref": "#/definitions/resource_ref"
    },
    "parent_revision_refs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/revision_ref"
      },
      "uniqueItems": true,
      "maxItems": 1
    },
    "element_mapping_ref": {
      "$ref": "#/definitions/resource_ref"
    },
    "boundary_mapping_ref": {
      "$ref": "#/definitions/resource_ref"
    },
    "host_requirements_ref": {
      "$ref": "#/definitions/resource_ref"
    },
    "source_contract": {
      "const": "rpnh/collaboration/graph_author_source/v1"
    },
    "graph_source_ref": {
      "$ref": "#/definitions/resource_ref"
    },
    "graph_recipe_ref": {
      "$ref": "#/definitions/resource_ref"
    },
    "graph_source_mapping_ref": {
      "$ref": "#/definitions/resource_ref"
    }
  },
  "required": [
    "schema_version",
    "revision_ref",
    "owner_task_ref",
    "producer_principal_ref",
    "command_id",
    "definition_kind",
    "definition_ref",
    "parent_revision_refs",
    "element_mapping_ref",
    "boundary_mapping_ref",
    "host_requirements_ref",
    "graph_source_ref",
    "graph_recipe_ref",
    "graph_source_mapping_ref",
    "source_contract"
  ]
}
