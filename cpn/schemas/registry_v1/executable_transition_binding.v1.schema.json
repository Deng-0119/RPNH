{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/executable_transition_binding/v1",
  "title": "Exact registered executable transition binding",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {"type": "object", "additionalProperties": false, "properties": {"entity_type": {"type": "string"}, "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}, "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}}, "required": ["entity_type", "logical_id", "version_id"]},
    "resource_ref": {"type": "object", "additionalProperties": false, "properties": {"resource_id": {"type": "string", "pattern": "^resource:[a-f0-9]{32}$"}, "resource_version_id": {"type": "string", "pattern": "^resource_version:[a-f0-9]{32}$"}}, "required": ["resource_id", "resource_version_id"]},
    "nullable_ref": {"oneOf": [{"$ref": "#/definitions/ref"}, {"type": "null"}]}
  },
  "properties": {
    "executable_transition_binding_ref": {"$ref": "#/definitions/ref"},
    "net_instance_ref": {"$ref": "#/definitions/ref"},
    "declaration_resource_ref": {"$ref": "#/definitions/resource_ref"},
    "declaration_schema_ref": {"type": "string", "minLength": 1},
    "transition_id": {"type": "string", "minLength": 1},
    "node_ref": {"$ref": "#/definitions/ref"},
    "activation_ref": {"$ref": "#/definitions/nullable_ref"},
    "agent_ref": {"$ref": "#/definitions/nullable_ref"},
    "operation_binding_ref": {"$ref": "#/definitions/ref"},
    "principal_ref": {"$ref": "#/definitions/ref"},
    "input_place_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "output_place_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "effects": {"type": "array", "items": {"type": "object", "additionalProperties": false, "properties": {"effect_id": {"type": "string", "minLength": 1}, "component_key": {"type": "string", "minLength": 1}, "witness": {"type": "object"}}, "required": ["effect_id", "component_key", "witness"]}}
  },
  "required": ["executable_transition_binding_ref", "net_instance_ref", "declaration_resource_ref", "declaration_schema_ref", "transition_id", "node_ref", "activation_ref", "agent_ref", "operation_binding_ref", "principal_ref", "input_place_ids", "output_place_ids"]
}
