{
  "$id": "registry_v1/node_declaration/v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {"ref": {"type": "object", "additionalProperties": false,
    "properties": {"entity_type": {"type": "string"},
      "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"},
      "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}},
    "required": ["entity_type", "logical_id", "version_id"]},
    "refs": {"type": "array", "items": {"$ref": "#/definitions/ref"}, "uniqueItems": true}},
  "properties": {
    "node_ref": {"$ref": "#/definitions/ref"},
    "semantic_node_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "node_synopsis": {"type": "string", "minLength": 1},
    "transition_id": {"type": "string", "minLength": 1},
    "activation_ref": {"oneOf": [{"$ref": "#/definitions/ref"}, {"type": "null"}]},
    "team_design_root_ref": {"$ref": "#/definitions/ref"},
    "plan_ref": {"$ref": "#/definitions/ref"},
    "opaque_role_artifact_ref": {"$ref": "#/definitions/ref"},
    "input_resource_refs": {"$ref": "#/definitions/refs"},
    "input_schema_refs": {"$ref": "#/definitions/refs"},
    "output_schema_refs": {"$ref": "#/definitions/refs"},
    "producer_operation_binding_ref": {"$ref": "#/definitions/ref"},
    "offered_output_binding_refs": {"$ref": "#/definitions/refs"},
    "resource_bounds": {"type": "object", "additionalProperties": false,
      "properties": {"max_llm_attempts": {"type": "integer", "minimum": 0},
        "max_tool_turns": {"type": "integer", "minimum": 0}},
      "required": ["max_llm_attempts", "max_tool_turns"]}
  },
  "required": ["node_ref", "semantic_node_id", "node_synopsis", "transition_id", "activation_ref",
    "team_design_root_ref", "plan_ref",
    "opaque_role_artifact_ref", "input_resource_refs", "input_schema_refs",
    "output_schema_refs", "producer_operation_binding_ref",
    "offered_output_binding_refs", "resource_bounds"],
  "title": "node_declaration/v1",
  "type": "object"
}
