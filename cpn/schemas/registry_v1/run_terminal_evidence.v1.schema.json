{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/run_terminal_evidence/v1",
  "title": "Unique run terminal evidence",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {"type": "object", "additionalProperties": false, "properties": {"entity_type": {"type": "string"}, "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}, "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}}, "required": ["entity_type", "logical_id", "version_id"]}
  },
  "properties": {
    "terminal_evidence_ref": {"$ref": "#/definitions/ref"},
    "run_ref": {"$ref": "#/definitions/ref"},
    "terminal_occurrence_ref": {"$ref": "#/definitions/ref"},
    "producer": {"type": "string", "minLength": 1},
    "run_outcome": {"enum": ["complete", "failed"]},
    "terminal_result_ref": {"$ref": "#/definitions/ref"},
    "final_result_index_ref": {"allOf": [{"$ref": "#/definitions/ref"}, {"properties": {"entity_type": {"const": "final_result_index/v1"}}}]},
    "final_checkpoint_ref": {"$ref": "#/definitions/ref"}
  },
  "required": ["terminal_evidence_ref", "run_ref", "terminal_occurrence_ref", "producer", "run_outcome", "terminal_result_ref", "final_result_index_ref", "final_checkpoint_ref"]
}
