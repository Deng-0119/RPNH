{
  "$id": "registry_v1/resource_address_unbound/v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "task_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "task/v1"},
        "logical_id": {"type": "string", "pattern": "^task:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^task_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "task_round_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "task_round/v1"},
        "logical_id": {"type": "string", "pattern": "^task_round:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^task_round_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "net_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "net_instance/v1"},
        "logical_id": {"type": "string", "pattern": "^net_instance:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^net_instance_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "invocation_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "invocation/v1"},
        "logical_id": {"type": "string", "pattern": "^invocation:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^invocation_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "activation_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "a2c_activation/v1"},
        "logical_id": {"type": "string", "pattern": "^a2c_activation:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^a2c_activation_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "scope_ref": {"oneOf": [
      {"$ref": "#/definitions/task_ref"}, {"$ref": "#/definitions/task_round_ref"},
      {"$ref": "#/definitions/net_ref"}, {"$ref": "#/definitions/invocation_ref"},
      {"$ref": "#/definitions/activation_ref"}
    ]},
    "address": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "scope_ref": {"$ref": "#/definitions/scope_ref"},
        "opaque_name": {"type": "string", "minLength": 1}
      }, "required": ["scope_ref", "opaque_name"]
    },
    "binding_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "resource_address_binding/v1"},
        "logical_id": {"type": "string", "pattern": "^resource_address_binding:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^resource_address_binding_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    }
  },
  "properties": {
    "binding_ref": {"$ref": "#/definitions/binding_ref"},
    "address": {"$ref": "#/definitions/address"},
    "previous_binding_ref": {"$ref": "#/definitions/binding_ref"},
    "resulting_stream_sequence": {"type": "integer", "minimum": 1}
  },
  "required": ["binding_ref", "address", "previous_binding_ref", "resulting_stream_sequence"]
}
