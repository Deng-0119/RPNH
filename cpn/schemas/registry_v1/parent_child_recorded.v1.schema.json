{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/parent_child_recorded/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "record_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_type": {
          "type": "string",
          "minLength": 1
        },
        "logical_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"
        },
        "version_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"
        }
      },
      "required": [
        "entity_type",
        "logical_id",
        "version_id"
      ]
    },
    "predecessor_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entity_type": {
            "type": "string",
            "minLength": 1
          },
          "logical_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"
          },
          "version_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"
          }
        },
        "required": [
          "entity_type",
          "logical_id",
          "version_id"
        ]
      }
    }
  },
  "required": [
    "record_ref",
    "predecessor_refs"
  ]
}
