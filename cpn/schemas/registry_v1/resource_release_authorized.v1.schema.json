{
  "$id": "registry_v1/resource_release_authorized/v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "delivery_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "resource_delivery/v1"},
        "logical_id": {"type": "string", "pattern": "^resource_delivery:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^resource_delivery_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "witness_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"const": "resource_release_witness/v1"},
        "logical_id": {"type": "string", "pattern": "^release_witness:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^release_witness_version:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    },
    "resource_ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "resource_id": {"type": "string", "pattern": "^resource:[a-f0-9]{32}$"},
        "resource_version_id": {"type": "string", "pattern": "^resource_version:[a-f0-9]{32}$"}
      }, "required": ["resource_id", "resource_version_id"]
    }
  },
  "properties": {
    "delivery_ref": {"$ref": "#/definitions/delivery_ref"},
    "witness_ref": {"$ref": "#/definitions/witness_ref"},
    "resource_ref": {"$ref": "#/definitions/resource_ref"},
    "resource_byte_count": {"type": "integer", "minimum": 0},
    "boundary": {"enum": ["llm_prompt", "tool_result", "subprocess_read", "parent_receipt", "petri_input"]},
    "expires_at": {"type": "string", "minLength": 1}
  },
  "required": ["delivery_ref", "witness_ref", "resource_ref", "resource_byte_count", "boundary", "expires_at"]
}
