{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/firing_external_kb_read/v2",
  "title": "Metadata search or exact-ID bounded KB read",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "ref": {"type": "object", "additionalProperties": false, "properties": {"entity_type": {"type": "string"}, "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}, "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}}, "required": ["entity_type", "logical_id", "version_id"]},
    "nullable_string": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "nullable_offset": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "metadata_item": {"type": "object", "additionalProperties": false, "properties": {"item_id": {"type": "string", "minLength": 1}, "byte_size": {"type": "integer", "minimum": 0}, "title": {"type": "string"}, "kind": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "summary_2_lines": {"type": "string"}, "score": {"type": "integer", "minimum": 1}, "rank": {"type": "integer", "minimum": 1}}, "required": ["item_id", "byte_size", "title", "kind", "tags", "summary_2_lines", "score", "rank"]},
    "body_page": {"type": "object", "additionalProperties": false, "properties": {"item_id": {"type": "string", "minLength": 1}, "byte_size": {"type": "integer", "minimum": 0}, "title": {"type": "string"}, "kind": {"type": "string"}, "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "summary_2_lines": {"type": "string"}, "body": {"type": "string"}, "offset_chars": {"type": "integer", "minimum": 0}, "returned_chars": {"type": "integer", "minimum": 0}, "total_chars": {"type": "integer", "minimum": 0}, "next_offset_chars": {"$ref": "#/definitions/nullable_offset"}, "complete": {"type": "boolean"}}, "required": ["item_id", "byte_size", "title", "kind", "tags", "summary_2_lines", "body", "offset_chars", "returned_chars", "total_chars", "next_offset_chars", "complete"]}
  },
  "properties": {
