    "transition_firing_ref": {"$ref": "#/definitions/ref"},
    "agent_action_ref": {"$ref": "#/definitions/ref"},
    "external_resource_index_ref": {"$ref": "#/definitions/ref"},
    "kb_package_ref": {"$ref": "#/definitions/ref"},
    "operation": {"enum": ["search", "read"]},
    "query": {"$ref": "#/definitions/nullable_string"},
    "kind": {"$ref": "#/definitions/nullable_string"},
    "tags_any": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "tags_all": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "search_offset": {"$ref": "#/definitions/nullable_offset"},
