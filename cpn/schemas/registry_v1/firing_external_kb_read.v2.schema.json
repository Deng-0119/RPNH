    "body_pages": {"type": "array", "items": {"$ref": "#/definitions/body_page"}, "uniqueItems": true},
    "outcome": {"enum": ["selected", "empty", "read_complete", "read_partial"]}
  },
  "required": ["kb_access_ref", "transition_firing_ref", "agent_action_ref", "external_resource_index_ref", "kb_package_ref", "operation", "query", "kind", "tags_any", "tags_all", "search_offset", "page_size", "total_search_results", "next_search_offset", "item_id", "offset_chars", "max_chars", "metadata_results", "body_pages", "outcome"],
  "allOf": [{"if": {"properties": {"operation": {"const": "search"}}}, "then": {"properties": {"query": {"type": "string", "minLength": 1}, "search_offset": {"type": "integer", "minimum": 0}, "page_size": {"type": "integer", "minimum": 1}, "total_search_results": {"type": "integer", "minimum": 0}, "item_id": {"type": "null"}, "offset_chars": {"type": "null"}, "max_chars": {"type": "null"}, "body_pages": {"maxItems": 0}, "outcome": {"enum": ["selected", "empty"]}}}, "else": {"properties": {"query": {"type": "null"}, "kind": {"type": "null"}, "tags_any": {"maxItems": 0}, "tags_all": {"maxItems": 0}, "search_offset": {"type": "null"}, "page_size": {"type": "null"}, "total_search_results": {"type": "null"}, "next_search_offset": {"type": "null"}, "item_id": {"type": "string", "minLength": 1}, "offset_chars": {"type": "integer", "minimum": 0}, "max_chars": {"type": "integer", "minimum": 1}, "metadata_results": {"maxItems": 0}, "body_pages": {"minItems": 1, "maxItems": 1}, "outcome": {"enum": ["read_complete", "read_partial"]}}}}]
