{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry_v1/execution_environment_identity/v1",
  "title": "Registry-backed ExecutionEnvironmentIdentity",
  "type": "object",
  "additionalProperties": false,
  "definitions": {"ref": {"type": "object", "additionalProperties": false, "properties": {"entity_type": {"type": "string", "minLength": 1}, "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}, "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}}, "required": ["entity_type", "logical_id", "version_id"]}},
  "properties": {
    "environment_ref": {"$ref": "#/definitions/ref"},
    "name": {"const": "research-exp"},
    "python_executable": {"type": "string", "pattern": "^/"},
    "python_prefix": {"type": "string", "pattern": "^/"}
  },
  "required": ["environment_ref", "name", "python_executable", "python_prefix"]
}
