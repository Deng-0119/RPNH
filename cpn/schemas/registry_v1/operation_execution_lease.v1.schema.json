{
  "$id": "registry_v1/operation_execution_lease/v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "definitions": {
    "ref": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "entity_type": {"type": "string"},
        "logical_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"},
        "version_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}$"}
      }, "required": ["entity_type", "logical_id", "version_id"]
    }
  },
  "properties": {
    "operation_execution_lease_ref": {"$ref": "#/definitions/ref"},
    "invocation_ref": {"$ref": "#/definitions/ref"},
    "writer_fencing_epoch": {"type": "integer", "minimum": 1},
    "lease_generation": {"type": "integer", "minimum": 1},
    "state": {"const": "dispatch_reserved"}
  },
  "required": ["operation_execution_lease_ref", "invocation_ref", "writer_fencing_epoch", "lease_generation", "state"]
}
