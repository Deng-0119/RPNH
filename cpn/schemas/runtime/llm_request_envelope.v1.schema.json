{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "runtime/llm_request_envelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol": {"const": "llm_request_envelope/v1"},
    "model_condition": {"type": "string", "minLength": 1},
    "max_output_tokens": {"type": "integer", "minimum": 1},
    "messages": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "tools": {"type": "array", "items": {"type": "object"}},
    "tool_choice": {"enum": ["auto", "none"]},
    "source_prompt_ref": {"type": "object"},
    "tool_catalog_ref": {"type": "object"},
    "placeholders": {"type": "array", "items": {"type": "object"}}
  },
  "required": [
    "protocol", "model_condition", "max_output_tokens", "messages",
    "tools", "tool_choice", "source_prompt_ref", "tool_catalog_ref",
    "placeholders"
  ]
}
