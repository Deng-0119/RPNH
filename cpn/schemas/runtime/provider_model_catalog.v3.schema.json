{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "runtime/provider_model_catalog/v3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "rpnh/provider_model_catalog/v3"},
    "providers": {
      "type": "array", "items": {"$ref": "#/definitions/provider"}
    }
  },
  "required": ["schema_version", "providers"],
  "definitions": {
    "identifier": {
      "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "opaqueText": {
      "type": "string", "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "positiveInteger": {"type": "integer", "minimum": 1},
    "workspacePolicy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "timeout_seconds": {"$ref": "#/definitions/positiveInteger"},
        "memory_bytes": {"$ref": "#/definitions/positiveInteger"},
        "process_limit": {"$ref": "#/definitions/positiveInteger"},
        "source_size_bytes": {"$ref": "#/definitions/positiveInteger"},
        "input_size_bytes": {"$ref": "#/definitions/positiveInteger"}
      },
      "required": [
        "timeout_seconds", "memory_bytes", "process_limit",
        "source_size_bytes", "input_size_bytes"
      ]
    },
    "runtimePolicy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "max_turns_per_node": {"$ref": "#/definitions/positiveInteger"},
        "max_parallel_nodes": {"$ref": "#/definitions/positiveInteger"},
        "main_history_message_limit": {"$ref": "#/definitions/positiveInteger"},
        "context_pressure_trigger_ratio": {
          "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1
        },
        "context_tool_output_byte_limit": {"type": "integer", "minimum": 128},
        "workspace": {"$ref": "#/definitions/workspacePolicy"}
      },
      "required": [
        "max_turns_per_node", "max_parallel_nodes",
        "main_history_message_limit", "context_pressure_trigger_ratio",
        "context_tool_output_byte_limit", "workspace"
      ]
    },
    "externalRecovery": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "strategy": {"const": "bounded_same_route_health_probe/v1"},
        "max_probe_attempts": {"type": "integer", "minimum": 1, "maximum": 3},
        "probe_timeout_budget_seconds": {"$ref": "#/definitions/positiveInteger"},
        "max_probe_success_formal_failure_cycles": {
          "type": "integer", "minimum": 1, "maximum": 3
        }
      },
      "required": [
        "strategy", "max_probe_attempts", "probe_timeout_budget_seconds",
        "max_probe_success_formal_failure_cycles"
      ]
    },
    "stringArray": {
      "type": "array", "minItems": 1, "items": {"type": "string"}
    },
    "credential": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "environment": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
            "header": {"type": "string", "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"},
            "prefix": {"type": "string", "maxLength": 1024}
          },
          "required": ["environment", "header", "prefix"]
        }
      ]
    },
    "reasoningEfforts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "supported": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/definitions/identifier"}
        },
        "default": {"$ref": "#/definitions/identifier"}
      },
      "required": ["supported", "default"]
    },
    "localAdapter": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "adapter_kind": {"const": "local_process"},
        "argv": {"$ref": "#/definitions/stringArray"},
        "probe_argv": {"$ref": "#/definitions/stringArray"},
        "env": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "additionalProperties": {"type": "string"}
        },
        "inherit_env": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
        }
      },
      "required": ["adapter_kind", "argv", "probe_argv", "env", "inherit_env"]
    },
    "externalAdapter": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "adapter_kind": {"const": "external_provider"},
        "route_id": {"$ref": "#/definitions/identifier"},
        "backend": {"$ref": "#/definitions/opaqueText"},
        "protocol": {"const": "openai_chat_completions/v1"},
        "endpoint": {
          "type": "string", "minLength": 9, "maxLength": 2048,
          "pattern": "^https?://[^?#]+$"
        },
        "credential": {"$ref": "#/definitions/credential"},
        "recovery": {"$ref": "#/definitions/externalRecovery"},
        "headers": {
          "type": "object",
          "propertyNames": {"pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"},
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      },
      "required": [
        "adapter_kind", "route_id", "backend", "protocol", "endpoint",
        "credential", "recovery", "headers"
      ]
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "profile": {"$ref": "#/definitions/identifier"},
        "model_condition": {"$ref": "#/definitions/opaqueText"},
        "reasoning_efforts": {"$ref": "#/definitions/reasoningEfforts"},
        "adapter": {
          "oneOf": [
            {"$ref": "#/definitions/localAdapter"},
            {"$ref": "#/definitions/externalAdapter"}
          ]
        },
        "timeout_seconds": {"$ref": "#/definitions/positiveInteger"},
        "max_output_tokens": {"$ref": "#/definitions/positiveInteger"},
        "max_response_bytes": {"$ref": "#/definitions/positiveInteger"},
        "context_window_tokens": {"$ref": "#/definitions/positiveInteger"},
        "context_compaction_retained_tokens": {"$ref": "#/definitions/positiveInteger"},
        "runtime": {"$ref": "#/definitions/runtimePolicy"}
      },
      "required": [
        "profile", "model_condition", "adapter", "timeout_seconds",
        "max_output_tokens", "max_response_bytes"
      ]
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "provider": {"$ref": "#/definitions/opaqueText"},
        "display_name": {"$ref": "#/definitions/opaqueText"},
        "models": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/definitions/model"}
        }
      },
      "required": ["provider", "display_name", "models"]
    }
  }
}
