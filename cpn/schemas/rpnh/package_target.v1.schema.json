{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rpnh/package_target/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "package_lock_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "root_manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "root_archive_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entry_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "maxLength": 120
    },
    "requirement_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "manifest_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "entry_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 120
          },
          "artifact_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "artifact_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "manifest_digest",
          "entry_id",
          "artifact_path",
          "artifact_digest"
        ]
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "requirements_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "package_lock_digest",
    "root_manifest_digest",
    "root_archive_digest",
    "entry_id",
    "requirement_artifacts",
    "requirements_digest"
  ]
}
