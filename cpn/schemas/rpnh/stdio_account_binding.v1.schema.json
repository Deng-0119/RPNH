{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rpnh/stdio_account_binding/v1",
  "title": "Fixed non-secret managed-tool account binding",
  "description": "Exact source-qualified account selection material only; it grants no account use or operation-input authority. Its own resource reference is held by AccountSelection.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rpnh/stdio_account_binding/v1"
    },
    "principal_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/source_version_ref/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entity_type": {
              "const": "principal/v1"
            },
            "logical_id": {
              "type": "string",
              "pattern": "^principal:[a-f0-9]{32}$"
            },
            "version_id": {
              "type": "string",
              "pattern": "^principal_version:[a-f0-9]{32}$"
            }
          },
          "required": [
            "entity_type",
            "logical_id",
            "version_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "ref"
      ]
    },
    "task_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/source_version_ref/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entity_type": {
              "const": "task/v1"
            },
            "logical_id": {
              "type": "string",
              "pattern": "^task:[a-f0-9]{32}$"
            },
            "version_id": {
              "type": "string",
              "pattern": "^task_version:[a-f0-9]{32}$"
            }
          },
          "required": [
            "entity_type",
            "logical_id",
            "version_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "ref"
      ]
    },
    "service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
    },
    "account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
    },
    "binding_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
    },
    "slot": {
      "enum": ["github_pat/v1", "github_oauth/v1"]
    }
  },
  "required": [
    "schema_version",
    "principal_ref",
    "task_ref",
    "service_id",
    "account_id",
    "binding_revision",
    "slot"
  ]
}
