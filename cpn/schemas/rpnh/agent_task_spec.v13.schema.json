{
  "$id": "rpnh/agent_task_spec/v13",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rpnh/agent_task_spec/v13"
    },
    "run_relative_path": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage_id",
          "instruction"
        ],
        "properties": {
          "stage_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "workflow_graph": {
      "type": "null"
    },
    "registered_execution_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default"
      ],
      "properties": {
        "default": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"
        }
      }
    },
    "max_attempts_per_stage": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "max_parallel_nodes": {
      "const": 1,
      "type": "integer"
    },
    "owner_statement": {
      "type": "string",
      "minLength": 1
    },
    "owner_socket_relative_path": {
      "const": "owner.sock"
    }
  },
  "required": [
    "schema_version",
    "run_relative_path",
    "prompt",
    "stages",
    "workflow_graph",
    "registered_execution_sources",
    "max_attempts_per_stage",
    "max_parallel_nodes",
    "owner_statement",
    "owner_socket_relative_path"
  ]
}
