{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rpnh/stdio_account_publication_config/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan",
    "provider_selection"
  ],
  "properties": {
    "schema_version": {
      "const": "rpnh/stdio_account_publication_config/v1"
    },
    "plan": {
      "$ref": "#/definitions/plan"
    },
    "provider_selection": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/provider"
        }
      ]
    }
  },
  "definitions": {
    "plan": {
      "title": "Explicit non-secret account binding plan",
      "description": "HOST-selected account metadata for the original PN binding publisher. No callbacks, credentials, executable locations or account grants.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/stdio_account_plan/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "node_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,47}$"
              },
              "tool_name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,47}$"
              },
              "service_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
              },
              "account_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
              },
              "binding_revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
              },
              "slot": {
                "const": "github_pat/v1"
              }
            },
            "required": [
              "node_id",
              "tool_name",
              "service_id",
              "account_id",
              "binding_revision",
              "slot"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "bindings"
      ]
    },
    "provider": {
      "title": "Explicit installed account provider selection",
      "description": "A non-secret HOST entry point and complete declared implementation identity. The handler field is compared only, never imported from this document.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "entry_point",
        "implementation"
      ],
      "properties": {
        "schema_version": {
          "const": "rpnh/installed_account_provider/v1"
        },
        "entry_point": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$(?![\\s\\S])"
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "implementation_id",
            "revision",
            "handler"
          ],
          "properties": {
            "schema_version": {
              "const": "rpnh/plugin_implementation/v2"
            },
            "implementation_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$(?![\\s\\S])"
            },
            "revision": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$(?![\\s\\S])"
            },
            "handler": {
              "type": "string",
              "minLength": 3,
              "maxLength": 512,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$(?![\\s\\S])"
            }
          }
        }
      }
    }
  }
}
