{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rpnh/registry_index_query/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_ids",
    "clauses",
    "page_size",
    "cuts",
    "sort"
  ],
  "properties": {
    "schema_version": {
      "const": "rpnh/registry_index_query/v1"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_type",
          "predicates",
          "projection"
        ],
        "properties": {
          "entry_type": {
            "type": "string",
            "minLength": 1
          },
          "predicates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "operator",
                "value"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "operator": {
                  "enum": [
                    "eq",
                    "in",
                    "lt",
                    "le",
                    "gt",
                    "ge"
                  ]
                },
                "value": {}
              }
            }
          },
          "projection": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "page_size": {
      "type": "integer",
      "minimum": 1
    },
    "cuts": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_id",
                  "cut_id",
                  "head",
                  "reader_contract_version"
                ],
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cut_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "head": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "ordinal",
                      "writer_fencing_epoch"
                    ],
                    "properties": {
                      "ordinal": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "writer_fencing_epoch": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "reader_contract_version": {
                    "const": "rpnh/registry_read/v1"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_id",
                  "ordinal"
                ],
                "properties": {
                  "source_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ordinal": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "sort": {
      "const": "source_type_identity_version"
    }
  }
}
