{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rpnh/parent_child_request/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rpnh/parent_child_request/v1"
    },
    "slot_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "child_kind": {
      "enum": [
        "agent_task",
        "module"
      ]
    },
    "definition": {
      "type": "object"
    },
    "public_configuration": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "slot_id",
    "child_kind",
    "definition",
    "public_configuration"
  ]
}
