{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rpnh/collaboration/assembly_plan/v4",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rpnh/collaboration/assembly_plan/v4"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
    },
    "owner_task_ref": {
      "$ref": "#/definitions/task_ref"
    },
    "producer_principal_ref": {
      "$ref": "#/definitions/principal_ref"
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
    },
    "parent_revision_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/assembly_ref"
        }
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?![\\s\\S])"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "member_id": {
            "type": "string",
            "pattern": "^member:[a-f0-9]{32}(?![\\s\\S])"
          },
          "display_name": {
            "type": "string"
          },
          "revision_ref": {
            "$ref": "#/definitions/net_revision_ref"
          },
          "resolution": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "proof_kind": {
                "enum": [
                  "plain_closed_v1",
                  "plain_merge_v1",
                  "adapted_result_current"
                ]
              },
              "command_ref": {
                "oneOf": [
                  {
                    "$ref": "#/definitions/resource_ref"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "definition_ref": {
                "$ref": "#/definitions/resource_ref"
              },
              "element_mapping_ref": {
                "$ref": "#/definitions/resource_ref"
              },
              "boundary_mapping_ref": {
                "$ref": "#/definitions/resource_ref"
              },
              "host_requirements_ref": {
                "$ref": "#/definitions/resource_ref"
              },
              "historical_origin_refs": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/resource_ref"
                },
                "maxItems": 0
              }
            },
            "required": [
              "proof_kind",
              "command_ref",
              "definition_ref",
              "element_mapping_ref",
              "boundary_mapping_ref",
              "host_requirements_ref",
              "historical_origin_refs"
            ]
          },
          "claim": {
            "enum": [
              "plain_closed_v1",
              "adapted_result_current"
            ]
          },
          "adaptation_ref": {
            "oneOf": [
              {
                "$ref": "#/definitions/resource_ref"
              },
              {
                "type": "null"
              }
            ]
          },
          "intent_ref": {
            "oneOf": [
              {
                "$ref": "#/definitions/resource_ref"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "member_id",
          "display_name",
          "revision_ref",
          "resolution",
          "claim",
          "adaptation_ref",
          "intent_ref"
        ]
      },
      "minItems": 1
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_member_id": {
            "type": "string",
            "pattern": "^member:[a-f0-9]{32}(?![\\s\\S])"
          },
          "source_exit_element_id": {
            "type": "string",
            "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
          },
          "target_member_id": {
            "type": "string",
            "pattern": "^member:[a-f0-9]{32}(?![\\s\\S])"
          },
          "target_entry_element_id": {
            "type": "string",
            "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
          }
        },
        "required": [
          "source_member_id",
          "source_exit_element_id",
          "target_member_id",
          "target_entry_element_id"
        ]
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "member_id": {
          "type": "string",
          "pattern": "^member:[a-f0-9]{32}(?![\\s\\S])"
        },
        "terminal_element_id": {
          "type": "string",
          "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
        }
      },
      "required": [
        "member_id",
        "terminal_element_id"
      ]
    },
    "budget_policy": {
      "const": "shared_exact"
    },
    "deployment_intent": {
      "const": "same_run_candidate"
    },
    "host_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/author_host_requirements/v1"
        },
        "registrations": {
          "type": "object"
        },
        "declaration_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "schema",
                  "component",
                  "executor",
                  "tool",
                  "analyzer"
                ]
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "resource_ref": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "schema_version": {
                    "const": "rpnh/collaboration/source_resource_ref/v1"
                  },
                  "source_id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
                  },
                  "ref": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "resource_id": {
                        "type": "string",
                        "pattern": "^resource:[a-f0-9]{32}(?![\\s\\S])"
                      },
                      "resource_version_id": {
                        "type": "string",
                        "pattern": "^resource_version:[a-f0-9]{32}(?![\\s\\S])"
                      }
                    },
                    "required": [
                      "resource_id",
                      "resource_version_id"
                    ]
                  }
                },
                "required": [
                  "schema_version",
                  "source_id",
                  "ref"
                ]
              }
            },
            "required": [
              "kind",
              "key",
              "resource_ref"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "registrations",
        "declaration_refs"
      ]
    },
    "resolver_recipe": {
      "const": {
        "contract": "rpnh/collaboration/direct_adapted_member_resolver/v1",
        "member_contracts": [
          "plain_closed_v1",
          "adapted_result_current"
        ],
        "history": "same_version_logical_history/v1",
        "containment": "direct_members/v1",
        "instance_identity": "exact_direct_member/v1",
        "component_scoping": "stable_member_uuid_prefix/v1",
        "public_boundary_scoping": "stable_member_uuid_prefix/v1",
        "constraints": "rpnh/assembly_member_constraints/v3",
        "budget_policy": "shared_exact",
        "completion": "selected_primary_with_alternatives/v1",
        "lowering": "actual_final_context_fragments/v1",
        "carrier_cut": "remove_only_assembly_connections/v1",
        "source_origins": "rpnh/collaboration/direct_adapted_member_origins/v1",
        "material_lock": "canonical_json_sha256_bytes/v1",
        "proof_authority": "explicit_assembly_entry/v1"
      }
    },
    "generated_revision_ref": {
      "$ref": "#/definitions/plain_revision_ref"
    },
    "prepared_materials": {
      "type": "array",
      "items": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": {
              "const": "definition"
            },
            "schema": {
              "const": "rpnh/module_declaration/v1"
            },
            "resource_ref": {
              "$ref": "#/definitions/resource_ref"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            }
          },
          "required": [
            "role",
            "schema",
            "resource_ref",
            "bytes",
            "sha256"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": {
              "const": "element_mapping"
            },
            "schema": {
              "const": "rpnh/collaboration/author_element_map/v1"
            },
            "resource_ref": {
              "$ref": "#/definitions/resource_ref"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            }
          },
          "required": [
            "role",
            "schema",
            "resource_ref",
            "bytes",
            "sha256"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": {
              "const": "boundary_mapping"
            },
            "schema": {
              "const": "rpnh/collaboration/author_boundary_map/v1"
            },
            "resource_ref": {
              "$ref": "#/definitions/resource_ref"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            }
          },
          "required": [
            "role",
            "schema",
            "resource_ref",
            "bytes",
            "sha256"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": {
              "const": "host_requirements"
            },
            "schema": {
              "const": "rpnh/collaboration/author_host_requirements/v1"
            },
            "resource_ref": {
              "$ref": "#/definitions/resource_ref"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            }
          },
          "required": [
            "role",
            "schema",
            "resource_ref",
            "bytes",
            "sha256"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": {
              "const": "compiled_inventory"
            },
            "schema": {
              "const": "rpnh/executable_net/v1"
            },
            "resource_ref": {
              "$ref": "#/definitions/resource_ref"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            }
          },
          "required": [
            "role",
            "schema",
            "resource_ref",
            "bytes",
            "sha256"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": {
              "const": "lowering_mapping"
            },
            "schema": {
              "const": "rpnh/collaboration/assembly_lowering_map/v4"
            },
            "resource_ref": {
              "$ref": "#/definitions/resource_ref"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            }
          },
          "required": [
            "role",
            "schema",
            "resource_ref",
            "bytes",
            "sha256"
          ]
        }
      ],
      "minItems": 6,
      "maxItems": 6,
      "additionalItems": false
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "owner_task_ref",
    "producer_principal_ref",
    "command_id",
    "parent_revision_ref",
    "name",
    "members",
    "connections",
    "completion",
    "budget_policy",
    "deployment_intent",
    "host_requirements",
    "resolver_recipe",
    "generated_revision_ref",
    "prepared_materials"
