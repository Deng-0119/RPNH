    "author_plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?![\\s\\S])"
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_member_id": {
                "type": "string",
                "pattern": "^member:[a-f0-9]{32}(?![\\s\\S])"
              },
              "source_exit_element_id": {
                "type": "string",
                "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
              },
              "target_member_id": {
                "type": "string",
                "pattern": "^member:[a-f0-9]{32}(?![\\s\\S])"
              },
              "target_entry_element_id": {
                "type": "string",
                "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
              }
            },
            "required": [
              "source_member_id",
              "source_exit_element_id",
              "target_member_id",
              "target_entry_element_id"
            ]
          }
        },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "member_id": {
              "type": "string",
              "pattern": "^member:[a-f0-9]{32}(?![\\s\\S])"
            },
            "terminal_element_id": {
              "type": "string",
              "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
            }
          },
          "required": [
            "member_id",
            "terminal_element_id"
          ]
        },
        "budget_policy": {
          "const": "shared_exact"
        },
        "deployment_intent": {
          "const": "same_run_candidate"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "member_id": {
                "type": "string",
                "pattern": "^member:[a-f0-9]{32}(?![\\s\\S])"
              },
              "display_name": {
                "type": "string"
              },
              "revision_ref": {
                "$ref": "#/definitions/net_revision_ref"
              }
            },
            "required": [
              "member_id",
              "display_name",
              "revision_ref"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "name",
        "connections",
        "completion",
        "budget_policy",
        "deployment_intent",
        "members"
      ]
