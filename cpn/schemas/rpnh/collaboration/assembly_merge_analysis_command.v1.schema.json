    "choice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "choice": {
          "enum": [
            "left",
            "right",
            "base",
            "delete",
            "exact"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "value": {}
      },
      "required": [
        "subject",
        "choice",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "choice": {
                "const": "exact"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          },
          "else": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        }
      ]
    },
