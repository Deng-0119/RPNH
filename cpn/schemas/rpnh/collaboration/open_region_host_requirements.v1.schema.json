{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rpnh/collaboration/open_region_host_requirements/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rpnh/collaboration/open_region_host_requirements/v1"
    },
    "provenance_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/source_resource_ref/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resource_id": {
              "type": "string",
              "pattern": "^resource:[a-f0-9]{32}(?![\\s\\S])"
            },
            "resource_version_id": {
              "type": "string",
              "pattern": "^resource_version:[a-f0-9]{32}(?![\\s\\S])"
            }
          },
          "required": [
            "resource_id",
            "resource_version_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "ref"
      ]
    },
    "source_host_requirements_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/source_resource_ref/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resource_id": {
              "type": "string",
              "pattern": "^resource:[a-f0-9]{32}(?![\\s\\S])"
            },
            "resource_version_id": {
              "type": "string",
              "pattern": "^resource_version:[a-f0-9]{32}(?![\\s\\S])"
            }
          },
          "required": [
            "resource_id",
            "resource_version_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "ref"
      ]
    },
    "declaration_pins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/author_host_requirements/v1"
        },
        "registrations": {
          "type": "object"
        },
        "declaration_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "schema",
                  "component",
                  "executor",
                  "tool",
                  "analyzer"
                ]
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "resource_ref": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "schema_version": {
                    "const": "rpnh/collaboration/source_resource_ref/v1"
                  },
                  "source_id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
                  },
                  "ref": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "resource_id": {
                        "type": "string",
                        "pattern": "^resource:[a-f0-9]{32}(?![\\s\\S])"
                      },
                      "resource_version_id": {
                        "type": "string",
                        "pattern": "^resource_version:[a-f0-9]{32}(?![\\s\\S])"
                      }
                    },
                    "required": [
                      "resource_id",
                      "resource_version_id"
                    ]
                  }
                },
                "required": [
                  "schema_version",
                  "source_id",
                  "ref"
                ]
              }
            },
            "required": [
              "kind",
              "key",
              "resource_ref"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "registrations",
        "declaration_refs"
      ]
    },
    "scope": {
      "const": "conservative_source_support"
    }
  },
  "required": [
    "schema_version",
    "provenance_ref",
    "source_host_requirements_ref",
    "declaration_pins",
    "scope"
  ]
}
