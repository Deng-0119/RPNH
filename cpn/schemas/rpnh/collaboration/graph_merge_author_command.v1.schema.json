{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rpnh/collaboration/graph_merge_author_command/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rpnh/collaboration/graph_merge_author_command/v1"
    },
    "algorithm": {
      "const": "rpnh/graph_source_resolution/v1"
    },
    "source_id": {
      "type": "string"
    },
    "owner_task_ref": {
      "$ref": "#/definitions/version_ref"
    },
    "producer_principal_ref": {
      "$ref": "#/definitions/version_ref"
    },
    "command_id": {
      "type": "string"
    },
    "schema_authorities": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "result_revision_ref": {
      "$ref": "#/definitions/version_ref"
    },
    "parent_revision_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/definitions/version_ref"
      }
    },
    "prepared_materials": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "resolution",
              "source",
              "recipe",
              "source_mapping",
              "definition",
              "element_mapping",
              "boundary_mapping",
              "host_requirements"
            ]
          },
          "schema": {
            "type": "string"
          },
          "resource_ref": {
            "$ref": "#/definitions/resource_ref"
          },
          "document": {
            "type": "object"
          },
          "metadata": {
            "type": "object"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "role",
          "schema",
          "resource_ref",
          "document",
          "metadata",
          "sha256",
          "bytes"
        ]
      }
    },
    "schema_authority_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
      }
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "merge"
            },
            "analysis_ref": {
              "$ref": "#/definitions/resource_ref"
            },
            "choices": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/choice"
              }
            }
          },
          "required": [
            "kind",
            "analysis_ref",
            "choices"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "edit"
            },
            "parent_ref": {
              "$ref": "#/definitions/version_ref"
            },
            "source": {
              "type": "object"
            },
            "recipe": {
              "type": "object"
            },
            "source_ids": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "copy_sources": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "parent_ref",
            "source",
            "recipe",
            "source_ids",
            "copy_sources"
          ]
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "algorithm",
    "source_id",
    "owner_task_ref",
    "producer_principal_ref",
    "command_id",
    "schema_authorities",
    "result_revision_ref",
    "parent_revision_refs",
    "prepared_materials",
    "schema_authority_sha256",
    "request"
  ],
  "definitions": {
    "version_ref": {
      "title": "Source version ref",
      "description": "Source qualification supplies identity only; it does not resolve a source, prove target existence, or grant access.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/source_version_ref/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entity_type": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(?:/[a-z][a-z0-9_]*)*/v[1-9][0-9]*(?![\\s\\S])"
            },
            "logical_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}(?![\\s\\S])"
            },
            "version_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}(?![\\s\\S])"
            }
          },
          "required": [
            "entity_type",
            "logical_id",
            "version_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "ref"
      ]
    },
    "resource_ref": {
      "title": "Source resource ref",
      "description": "Source qualification supplies identity only; it does not resolve a source, prove target existence, or grant access.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/source_resource_ref/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resource_id": {
              "type": "string",
              "pattern": "^resource:[a-f0-9]{32}(?![\\s\\S])"
            },
            "resource_version_id": {
              "type": "string",
              "pattern": "^resource_version:[a-f0-9]{32}(?![\\s\\S])"
            }
          },
          "required": [
            "resource_id",
            "resource_version_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "ref"
      ]
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conflict_id": {
          "type": "string",
          "pattern": "^conflict:[a-f0-9]{64}(?![\\s\\S])"
        },
        "selections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subject": {
                "type": "string"
              },
              "side": {
                "enum": [
                  "base",
                  "local",
                  "incoming"
                ]
              }
            },
            "required": [
              "subject",
              "side"
            ]
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "conflict_id",
        "selections",
        "reason"
      ]
    }
  }
}
