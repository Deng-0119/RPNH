{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rpnh/collaboration/graph_merge_resolution/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rpnh/collaboration/graph_merge_resolution/v1"
    },
    "algorithm": {
      "const": "rpnh/graph_source_resolution/v1"
    },
    "kind": {
      "enum": [
        "merge",
        "edit"
      ]
    },
    "analysis_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/resource_ref"
        }
      ]
    },
    "choices": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/choice"
      }
    },
    "identity_origins": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision_ref": {
            "$ref": "#/definitions/version_ref"
          },
          "element_id": {
            "type": "string",
            "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
          },
          "copied_from": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "revision_ref": {
                    "$ref": "#/definitions/version_ref"
                  },
                  "element_id": {
                    "type": "string",
                    "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
                  }
                },
                "required": [
                  "revision_ref",
                  "element_id"
                ]
              }
            ]
          }
        },
        "required": [
          "revision_ref",
          "element_id",
          "copied_from"
        ]
      }
    },
    "selected_atoms": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "algorithm",
    "kind",
    "analysis_ref",
    "choices",
    "identity_origins",
    "selected_atoms"
  ],
  "definitions": {
    "version_ref": {
      "title": "Source version ref",
      "description": "Source qualification supplies identity only; it does not resolve a source, prove target existence, or grant access.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/source_version_ref/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entity_type": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(?:/[a-z][a-z0-9_]*)*/v[1-9][0-9]*(?![\\s\\S])"
            },
            "logical_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}(?![\\s\\S])"
            },
            "version_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}(?![\\s\\S])"
            }
          },
          "required": [
            "entity_type",
            "logical_id",
            "version_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "ref"
      ]
    },
    "resource_ref": {
      "title": "Source resource ref",
      "description": "Source qualification supplies identity only; it does not resolve a source, prove target existence, or grant access.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/source_resource_ref/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resource_id": {
              "type": "string",
              "pattern": "^resource:[a-f0-9]{32}(?![\\s\\S])"
            },
            "resource_version_id": {
              "type": "string",
              "pattern": "^resource_version:[a-f0-9]{32}(?![\\s\\S])"
            }
          },
          "required": [
            "resource_id",
            "resource_version_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "ref"
      ]
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conflict_id": {
          "type": "string",
          "pattern": "^conflict:[a-f0-9]{64}(?![\\s\\S])"
        },
        "selections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subject": {
                "type": "string"
              },
              "side": {
                "enum": [
                  "base",
                  "local",
                  "incoming"
                ]
              }
            },
            "required": [
              "subject",
              "side"
            ]
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "conflict_id",
        "selections",
        "reason"
      ]
    }
  }
}
