{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rpnh/collaboration/author_boundary_map/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rpnh/collaboration/author_boundary_map/v1"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "element_id": {
            "type": "string",
            "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
          },
          "port_element_id": {
            "type": "string",
            "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
          }
        },
        "required": [
          "element_id",
          "port_element_id"
        ]
      }
    },
    "exits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "element_id": {
            "type": "string",
            "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
          },
          "port_element_id": {
            "type": "string",
            "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
          }
        },
        "required": [
          "element_id",
          "port_element_id"
        ]
      }
    },
    "terminals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "element_id": {
            "type": "string",
            "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
          },
          "port_element_id": {
            "type": "string",
            "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
          },
          "operation_element_id": {
            "type": "string",
            "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
          }
        },
        "required": [
          "element_id",
          "port_element_id",
          "operation_element_id"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "entries",
    "exits",
    "terminals"
  ]
}
