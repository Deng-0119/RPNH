{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rpnh/collaboration/assembly_plan/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rpnh/collaboration/assembly_plan/v1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
    },
    "owner_task_ref": {
      "$ref": "#/definitions/task_ref"
    },
    "producer_principal_ref": {
      "$ref": "#/definitions/principal_ref"
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
    },
    "parent_revision_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/assembly_ref"
        }
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?![\\s\\S])"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "member_id": {
            "type": "string",
            "pattern": "^member:[a-f0-9]{32}(?![\\s\\S])"
          },
          "display_name": {
            "type": "string"
          },
          "revision_ref": {
            "$ref": "#/definitions/net_revision_ref"
          }
        },
        "required": [
          "member_id",
          "display_name",
          "revision_ref"
        ]
      },
      "minItems": 1
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_member_id": {
            "type": "string",
            "pattern": "^member:[a-f0-9]{32}(?![\\s\\S])"
          },
          "source_exit_element_id": {
            "type": "string",
            "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
          },
          "target_member_id": {
            "type": "string",
            "pattern": "^member:[a-f0-9]{32}(?![\\s\\S])"
          },
          "target_entry_element_id": {
            "type": "string",
            "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
          }
        },
        "required": [
          "source_member_id",
          "source_exit_element_id",
          "target_member_id",
          "target_entry_element_id"
        ]
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "member_id": {
          "type": "string",
          "pattern": "^member:[a-f0-9]{32}(?![\\s\\S])"
        },
        "terminal_element_id": {
          "type": "string",
          "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
        }
      },
      "required": [
        "member_id",
        "terminal_element_id"
      ]
    },
    "budget_policy": {
      "const": "shared_exact"
    },
    "deployment_intent": {
      "const": "same_run_candidate"
    },
    "host_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/author_host_requirements/v1"
        },
        "registrations": {
          "type": "object"
        },
        "declaration_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "schema",
                  "component",
                  "executor",
                  "tool",
                  "analyzer"
                ]
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "resource_ref": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "schema_version": {
                    "const": "rpnh/collaboration/source_resource_ref/v1"
                  },
                  "source_id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
                  },
                  "ref": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "resource_id": {
                        "type": "string",
                        "pattern": "^resource:[a-f0-9]{32}(?![\\s\\S])"
                      },
                      "resource_version_id": {
                        "type": "string",
                        "pattern": "^resource_version:[a-f0-9]{32}(?![\\s\\S])"
                      }
                    },
                    "required": [
                      "resource_id",
                      "resource_version_id"
                    ]
                  }
                },
                "required": [
                  "schema_version",
                  "source_id",
                  "ref"
                ]
              }
            },
            "required": [
              "kind",
              "key",
              "resource_ref"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "registrations",
        "declaration_refs"
      ]
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "owner_task_ref",
    "producer_principal_ref",
    "command_id",
    "parent_revision_ref",
    "name",
    "members",
    "connections",
    "completion",
    "budget_policy",
    "deployment_intent",
    "host_requirements"
  ],
  "definitions": {
    "task_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/source_version_ref/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entity_type": {
              "const": "task/v1"
            },
            "logical_id": {
              "type": "string",
              "pattern": "^task:[a-f0-9]{32}(?![\\s\\S])"
            },
            "version_id": {
              "type": "string",
              "pattern": "^task_version:[a-f0-9]{32}(?![\\s\\S])"
            }
          },
          "required": [
            "entity_type",
            "logical_id",
            "version_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "ref"
      ]
    },
    "principal_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/source_version_ref/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entity_type": {
              "const": "principal/v1"
            },
            "logical_id": {
              "type": "string",
              "pattern": "^principal:[a-f0-9]{32}(?![\\s\\S])"
            },
            "version_id": {
              "type": "string",
              "pattern": "^principal_version:[a-f0-9]{32}(?![\\s\\S])"
            }
          },
          "required": [
            "entity_type",
            "logical_id",
            "version_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "ref"
      ]
    },
    "resource_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/source_resource_ref/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resource_id": {
              "type": "string",
              "pattern": "^resource:[a-f0-9]{32}(?![\\s\\S])"
            },
            "resource_version_id": {
              "type": "string",
              "pattern": "^resource_version:[a-f0-9]{32}(?![\\s\\S])"
            }
          },
          "required": [
            "resource_id",
            "resource_version_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "ref"
      ]
    },
    "net_revision_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/source_version_ref/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entity_type": {
              "const": "collaboration_net_revision/v1"
            },
            "logical_id": {
              "type": "string",
              "pattern": "^resource:[a-f0-9]{32}(?![\\s\\S])"
            },
            "version_id": {
              "type": "string",
              "pattern": "^resource_version:[a-f0-9]{32}(?![\\s\\S])"
            }
          },
          "required": [
            "entity_type",
            "logical_id",
            "version_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "ref"
      ]
    },
    "assembly_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/source_version_ref/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entity_type": {
              "const": "collaboration_assembly_revision/v1"
            },
            "logical_id": {
              "type": "string",
              "pattern": "^resource:[a-f0-9]{32}(?![\\s\\S])"
            },
            "version_id": {
              "type": "string",
              "pattern": "^resource_version:[a-f0-9]{32}(?![\\s\\S])"
            }
          },
          "required": [
            "entity_type",
            "logical_id",
            "version_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "ref"
      ]
    }
  }
}
