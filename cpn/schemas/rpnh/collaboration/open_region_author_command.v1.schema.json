  "required": [
    "schema_version",
    "algorithm",
    "source_id",
    "owner_task_ref",
    "producer_principal_ref",
    "command_id",
    "request",
    "schema_authorities",
    "schema_authority_sha256",
    "result_revision_ref",
    "parent_revision_refs",
    "selected_change_refs",
    "prepared_materials"
  ]
