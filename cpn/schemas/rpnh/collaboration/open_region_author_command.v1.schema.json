              "logical_id",
              "version_id"
            ]
          }
        },
        "required": [
          "schema_version",
          "source_id",
          "ref"
        ]
      },
      "maxItems": 0
    },
    "selected_change_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "rpnh/collaboration/source_resource_ref/v1"
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
          },
          "ref": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resource_id": {
                "type": "string",
                "pattern": "^resource:[a-f0-9]{32}(?![\\s\\S])"
              },
              "resource_version_id": {
                "type": "string",
                "pattern": "^resource_version:[a-f0-9]{32}(?![\\s\\S])"
              }
            },
            "required": [
              "resource_id",
              "resource_version_id"
            ]
          }
        },
        "required": [
          "schema_version",
          "source_id",
          "ref"
        ]
      },
      "maxItems": 0
    },
    "prepared_materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "provenance",
              "definition",
              "element_mapping",
              "boundary_mapping",
              "host_requirements",
              "open_contract"
            ]
          },
          "schema": {
            "type": "string"
          },
          "resource_ref": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schema_version": {
                "const": "rpnh/collaboration/source_resource_ref/v1"
              },
