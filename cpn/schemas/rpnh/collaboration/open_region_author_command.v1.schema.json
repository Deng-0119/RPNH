                "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
              },
              "ref": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "resource_id": {
                    "type": "string",
                    "pattern": "^resource:[a-f0-9]{32}(?![\\s\\S])"
                  },
                  "resource_version_id": {
                    "type": "string",
                    "pattern": "^resource_version:[a-f0-9]{32}(?![\\s\\S])"
                  }
                },
                "required": [
                  "resource_id",
                  "resource_version_id"
                ]
              }
            },
            "required": [
              "schema_version",
              "source_id",
              "ref"
            ]
          },
          "document": {
            "type": "object"
          },
          "metadata": {
            "type": "object"
          },
          "payload_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "payload_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          }
        },
        "required": [
          "role",
          "schema",
          "resource_ref",
          "document",
          "metadata",
          "payload_bytes",
          "payload_sha256"
        ]
