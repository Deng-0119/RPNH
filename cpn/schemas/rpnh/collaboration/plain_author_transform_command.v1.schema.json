{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rpnh/collaboration/plain_author_transform_command/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rpnh/collaboration/plain_author_transform_command/v1"
    },
    "source_id": {
      "type": "string"
    },
    "owner_task_ref": {
      "$ref": "#/definitions/version_ref"
    },
    "producer_principal_ref": {
      "$ref": "#/definitions/version_ref"
    },
    "command_id": {
      "type": "string"
    },
    "schema_authorities": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "result_revision_ref": {
      "$ref": "#/definitions/version_ref"
    },
    "parent_revision_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/definitions/version_ref"
      }
    },
    "selected_change_refs": {
      "type": "array",
      "maxItems": 0
    },
    "prepared_materials": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "transformation",
              "definition",
              "element_mapping",
              "boundary_mapping",
              "host_requirements"
            ]
          },
          "schema": {
            "type": "string"
          },
          "resource_ref": {
            "$ref": "#/definitions/resource_ref"
          },
          "document": {
            "type": "object"
          },
          "metadata": {
            "type": "object"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          }
        },
        "required": [
          "role",
          "schema",
          "resource_ref",
          "document",
          "metadata",
          "sha256"
        ]
      }
    },
    "schema_authority_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
      }
    },
    "contract": {
      "const": "rpnh/plain_author_identity_transform/v1"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parent_ref": {
          "$ref": "#/definitions/version_ref"
        },
        "module": {
          "type": "object"
        },
        "element_ids": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
          }
        },
        "transform_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "split",
                  "fusion"
                ]
              },
              "source_revision_ref": {
                "$ref": "#/definitions/version_ref"
              },
              "source_element_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "target_element_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "kind",
              "source_revision_ref",
              "source_element_ids",
              "target_element_ids"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "copy_sources": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
          }
        },
        "created_element_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
          },
          "uniqueItems": true
        },
        "removed_element_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "parent_ref",
        "module",
        "element_ids",
        "transform_groups",
        "copy_sources",
        "created_element_ids",
        "removed_element_ids"
      ]
    },
    "source_binding": {
      "type": "object"
    },
    "input_pins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "entity_type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(?:/[a-z][a-z0-9_]*)*/v[1-9][0-9]*(?![\\s\\S])"
              },
              "logical_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}(?![\\s\\S])"
              },
              "version_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}(?![\\s\\S])"
              }
            },
            "required": [
              "entity_type",
              "logical_id",
              "version_id"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          },
          "metadata_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
          }
        },
        "required": [
          "ref",
          "bytes",
          "sha256",
          "metadata_sha256"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "owner_task_ref",
    "producer_principal_ref",
    "command_id",
    "schema_authorities",
    "result_revision_ref",
    "parent_revision_refs",
    "selected_change_refs",
    "prepared_materials",
    "schema_authority_sha256",
    "contract",
    "request",
    "source_binding",
    "input_pins"
  ],
  "definitions": {
    "version_ref": {
      "title": "Source version ref",
      "description": "Source qualification supplies identity only; it does not resolve a source, prove target existence, or grant access.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/source_version_ref/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entity_type": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(?:/[a-z][a-z0-9_]*)*/v[1-9][0-9]*(?![\\s\\S])"
            },
            "logical_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}(?![\\s\\S])"
            },
            "version_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*:[a-f0-9]{32}(?![\\s\\S])"
            }
          },
          "required": [
            "entity_type",
            "logical_id",
            "version_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "ref"
      ]
    },
    "resource_ref": {
      "title": "Source resource ref",
      "description": "Source qualification supplies identity only; it does not resolve a source, prove target existence, or grant access.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/source_resource_ref/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resource_id": {
              "type": "string",
              "pattern": "^resource:[a-f0-9]{32}(?![\\s\\S])"
            },
            "resource_version_id": {
              "type": "string",
              "pattern": "^resource_version:[a-f0-9]{32}(?![\\s\\S])"
            }
          },
          "required": [
            "resource_id",
            "resource_version_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "ref"
      ]
    }
  }
}
