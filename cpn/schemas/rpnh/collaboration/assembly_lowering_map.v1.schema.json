{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rpnh/collaboration/assembly_lowering_map/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rpnh/collaboration/assembly_lowering_map/v1"
    },
    "origins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "member_id": {
            "type": "string",
            "pattern": "^member:[a-f0-9]{32}(?![\\s\\S])"
          },
          "revision_ref": {
            "$ref": "#/definitions/net_revision_ref"
          },
          "element_id": {
            "type": "string",
            "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
          },
          "kind": {
            "enum": [
              "module",
              "component",
              "port",
              "operation",
              "link",
              "entry",
              "exit",
              "terminal"
            ]
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "retained",
              "flattened",
              "consumed",
              "root_completion",
              "not_root_completion"
            ]
          },
          "declaration_locators": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "member_id",
          "revision_ref",
          "element_id",
          "kind",
          "source_locator",
          "disposition",
          "declaration_locators"
        ]
      }
    },
    "introduced": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "declaration_locators": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "source_locator",
          "declaration_locators"
        ]
      }
    },
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "element_id": {
            "type": "string",
            "pattern": "^element:[a-f0-9]{32}(?![\\s\\S])"
          },
          "kind": {
            "enum": [
              "module",
              "component",
              "port",
              "operation",
              "link",
              "entry",
              "exit",
              "terminal"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "compiled_targets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "element_id",
          "kind",
          "locator",
          "compiled_targets"
        ]
      }
    },
    "place_aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "original_place": {
            "type": "string",
            "minLength": 1
          },
          "compiled_place": {
            "type": "string",
            "minLength": 1
          },
          "compiled_targets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "original_place",
          "compiled_place",
          "compiled_targets"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "origins",
    "introduced",
    "declarations",
    "place_aliases"
  ],
  "definitions": {
    "net_revision_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rpnh/collaboration/source_version_ref/v1"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entity_type": {
              "const": "collaboration_net_revision/v1"
            },
            "logical_id": {
              "type": "string",
              "pattern": "^resource:[a-f0-9]{32}(?![\\s\\S])"
            },
            "version_id": {
              "type": "string",
              "pattern": "^resource_version:[a-f0-9]{32}(?![\\s\\S])"
            }
          },
          "required": [
            "entity_type",
            "logical_id",
            "version_id"
          ]
        }
      },
      "required": [
        "schema_version",
        "source_id",
        "ref"
      ]
    }
  }
}
