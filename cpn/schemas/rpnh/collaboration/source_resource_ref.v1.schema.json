{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rpnh/collaboration/source_resource_ref/v1",
  "title": "Source resource ref",
  "description": "Source qualification supplies identity only; it does not resolve a source, prove target existence, or grant access.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rpnh/collaboration/source_resource_ref/v1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "type": "string",
          "pattern": "^resource:[a-f0-9]{32}(?![\\s\\S])"
        },
        "resource_version_id": {
          "type": "string",
          "pattern": "^resource_version:[a-f0-9]{32}(?![\\s\\S])"
        }
      },
      "required": [
        "resource_id",
        "resource_version_id"
      ]
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "ref"
  ]
}
