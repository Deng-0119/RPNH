                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "schema_version": {
                              "const": "rpnh/collaboration/source_version_ref/v1"
                            },
                            "source_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1024
                            },
                            "ref": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "entity_type": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 1024
                                },
                                "logical_id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 1024
                                },
                                "version_id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 1024
                                }
                              },
                              "required": [
                                "entity_type",
                                "logical_id",
                                "version_id"
                              ]
                            }
                          },
                          "required": [
                            "schema_version",
                            "source_id",
                            "ref"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "origin_digest": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "artifact_path",
                    "relation",
                    "origin_ref",
                    "origin_digest"
                  ]
                },
                "minItems": 0,
                "maxItems": 128
              },
              "manifest_schema": {
                "const": "rpnh/share_package/v2"
              },
