                    "artifact_path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    },
                    "artifact_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "schema_version": {
                      "const": "rpnh/environment_requirements/v1"
                    }
                  },
                  "required": [
                    "entry_id",
                    "artifact_path",
                    "artifact_digest",
                    "schema_version"
                  ]
