                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    },
                    "relation": {
                      "enum": [
                        "authored",
                        "copied",
                        "derived"
                      ]
                    },
                    "origin_ref": {
                      "anyOf": [
