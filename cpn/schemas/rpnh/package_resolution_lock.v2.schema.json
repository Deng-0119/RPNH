          "artifact_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "direct_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "schema_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
