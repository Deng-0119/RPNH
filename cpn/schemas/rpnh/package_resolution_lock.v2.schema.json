          "dependency_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "maxLength": 120
          },
          "to_manifest_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "required": {
            "const": true
          }
        },
        "required": [
          "from_manifest_digest",
          "dependency_id",
          "to_manifest_digest",
          "required"
