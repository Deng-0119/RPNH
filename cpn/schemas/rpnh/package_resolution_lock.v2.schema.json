{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rpnh/package_resolution_lock/v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rpnh/package_resolution_lock/v2"
    },
    "resolver_contract": {
      "const": "rpnh/package_resolver/v2"
    },
    "root_manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "root_entry_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "maxLength": 120
    },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "package_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]*(?:/[a-z][a-z0-9_.-]*)+$",
                "maxLength": 160
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
                "maxLength": 64
              },
              "manifest_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "archive_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4194304
                    }
                  },
                  "required": [
                    "path",
                    "sha256",
                    "bytes"
                  ]
                },
                "minItems": 1,
                "maxItems": 127
              },
              "origin": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "repository_url": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "commit": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "publisher_claim": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "source_refs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "schema_version": {
                          "const": "rpnh/collaboration/source_version_ref/v1"
                        },
                        "source_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1024
                        },
                        "ref": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "entity_type": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1024
                            },
                            "logical_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1024
                            },
                            "version_id": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 1024
                            }
                          },
                          "required": [
                            "entity_type",
                            "logical_id",
                            "version_id"
                          ]
                        }
                      },
                      "required": [
                        "schema_version",
                        "source_id",
                        "ref"
                      ]
