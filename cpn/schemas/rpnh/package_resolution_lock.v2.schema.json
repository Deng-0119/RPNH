          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "package_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]*(?:/[a-z][a-z0-9_.-]*)+$",
                "maxLength": 160
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
