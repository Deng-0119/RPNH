{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rpnh/stdio_account_plan/v1",
  "title": "Explicit non-secret account binding plan",
  "description": "HOST-selected account metadata for the original PN binding publisher. No callbacks, credentials, executable locations or account grants.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rpnh/stdio_account_plan/v1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "tool_name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "service_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
          },
          "account_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
          },
          "binding_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?(?![\\s\\S])"
          },
          "slot": {
            "enum": ["github_pat/v1", "github_oauth/v1"]
          }
        },
        "required": [
          "node_id",
          "tool_name",
          "service_id",
          "account_id",
          "binding_revision",
          "slot"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "bindings"
  ]
}
