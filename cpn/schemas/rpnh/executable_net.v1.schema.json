{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rpnh/executable_net/v1",
  "title": "Compiled RPNH publication inventory (not an authoring schema)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "fragments",
    "symbolic",
    "registrations",
    "operation_handles",
    "port_handles",
    "place_aliases",
    "ports"
  ],
  "properties": {
    "schema_version": {
      "const": "rpnh/executable_net/v1"
    },
    "source": {
      "$ref": "#/definitions/module"
    },
    "fragments": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/fragment"
      }
    },
    "symbolic": {
      "$ref": "#/definitions/net"
    },
    "registrations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object"
        }
      }
    },
    "operation_handles": {
      "$ref": "#/definitions/handles"
    },
    "port_handles": {
      "$ref": "#/definitions/handles"
    },
    "place_aliases": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/symbol"
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/compiled_port"
      }
    }
  },
  "definitions": {
    "symbol": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z][A-Za-z0-9_-]*)?$"
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "symbols": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/symbol"
      }
    },
    "keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/key"
      }
    },
    "schema_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:/[a-z][a-z0-9_]*)+/v[1-9][0-9]*$"
    },
    "handles": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "schema",
        "channel",
        "capacity",
        "token_kind",
        "schema_variants",
        "colours",
        "initial_tokens",
        "reusable"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/symbol"
        },
        "schema": {
          "$ref": "#/definitions/schema_id"
        },
        "channel": {
          "enum": [
            "data",
            "control"
          ]
        },
        "capacity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "token_kind": {
          "enum": [
            "data",
            "agent_resource",
            "counter",
            "decision",
            "resource_lease"
          ]
        },
        "schema_variants": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/schema_id"
          }
        },
        "colours": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/colour"
          }
