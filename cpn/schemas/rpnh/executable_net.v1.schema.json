        "direction": {
          "enum": [
            "input",
            "output"
          ]
        },
        "weight": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "enum": [
            "consume",
            "read",
            "borrow",
            "guard",
            "produce",
            "return"
          ]
