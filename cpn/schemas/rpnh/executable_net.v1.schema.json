        },
        "direction": {
          "enum": [
            "input",
            "output"
          ]
        },
        "schema": {
          "$ref": "#/definitions/schema_id"
        },
        "channel": {
          "enum": [
            "data",
            "control"
          ]
        },
        "cardinality": {
          "type": "integer",
          "minimum": 1
        },
        "cardinality_minimum": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Inclusive minimum; omitted or null uses cardinality."
        },
        "cardinality_maximum": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Inclusive maximum; omitted or null uses cardinality."
        },
        "place": {
          "$ref": "#/definitions/symbol"
        },
