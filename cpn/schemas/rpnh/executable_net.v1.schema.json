          "type": "array",
          "items": {
            "$ref": "#/definitions/input_verdict"
          }
        }
      }
    },
    "arc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "place",
        "transition",
        "direction",
        "weight",
        "mode",
        "outcome",
        "emit",
        "forward_source",
        "colour_expression",
        "output_predicates",
        "lease_claims",
        "lease_claim_exclusions",
        "lease_claim_set",
        "effect_selector"
