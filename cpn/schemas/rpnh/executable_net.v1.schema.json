    "module": {
      "title": "Symbolic RPNH ModuleDeclaration",
      "description": "Only symbolic identities and registered keys. Mechanical Registry identities are minted by the trusted execution host after lowering.",
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "rpnh/module_declaration/v1"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/module/definitions/component"
          },
          "minItems": 1
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/module/definitions/link"
          },
          "minItems": 0
        },
        "entry": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/module/definitions/endpoint"
          }
        },
        "exit": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/module/definitions/endpoint"
          },
          "minProperties": 1
        },
        "terminal": {
          "$ref": "#/definitions/module/definitions/terminal"
        },
        "required_schemas": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(?:/[a-z][a-z0-9_]*)+/v[1-9][0-9]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "budgets": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "designer_constraints": {
          "type": "object"
        },
        "analyzers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "budget_buckets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/module/definitions/budget_bucket"
          }
        },
        "terminal_alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/module/definitions/terminal"
          }
        }
      },
      "required": [
        "schema_version",
        "name",
        "components",
        "links",
        "entry",
        "exit",
        "terminal",
        "required_schemas",
        "budgets"
      ],
      "additionalProperties": false,
      "definitions": {
        "endpoint": {
          "type": "object",
          "properties": {
            "component": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "port": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            }
          },
          "required": [
            "component",
            "port"
          ],
          "additionalProperties": false
        },
        "port": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "direction": {
              "enum": [
                "input",
                "output"
              ]
            },
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(?:/[a-z][a-z0-9_]*)+/v[1-9][0-9]*$"
            },
            "channel": {
              "enum": [
                "data",
                "control"
              ],
              "default": "data"
            },
            "cardinality": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "cardinality_minimum": {
              "type": ["integer", "null"],
              "minimum": 0,
              "description": "Inclusive minimum; omitted or null uses cardinality."
            },
            "cardinality_maximum": {
              "type": ["integer", "null"],
              "minimum": 0,
              "description": "Inclusive maximum; omitted or null uses cardinality."
            }
          },
          "required": [
            "name",
            "direction",
            "schema"
          ],
          "additionalProperties": false
        },
        "product": {
          "type": "object",
          "properties": {
            "port": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "minimum": {
              "type": "integer",
              "minimum": 0,
              "default": 1
            },
            "maximum": {
              "type": "integer",
              "minimum": 0,
              "default": 1
            }
          },
          "required": [
            "port"
          ],
          "additionalProperties": false
        },
        "effect": {
          "type": "object",
          "properties": {
