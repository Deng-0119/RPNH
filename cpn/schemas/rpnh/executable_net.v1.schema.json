        },
        "lease_claim_set": {
          "anyOf": [
            {
              "$ref": "#/definitions/lease_claim_set_expression"
            },
            {
              "type": "null"
            }
          ]
        },
        "effect_selector": {
          "anyOf": [
            {
              "$ref": "#/definitions/symbol"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "reset_arc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "place",
        "transition",
        "selector",
        "outcome"
      ],
      "properties": {
        "place": {
          "$ref": "#/definitions/symbol"
        },
        "transition": {
          "$ref": "#/definitions/symbol"
        },
        "selector": {
          "$ref": "#/definitions/symbol"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/definitions/symbol"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "places",
        "transitions",
        "arcs",
        "ports",
        "operations",
        "internal_ports",
        "internal_bindings",
        "lease_identities",
        "lease_pools",
        "variable_resource_arcs",
        "logical_slots",
        "reset_arcs"
      ],
      "properties": {
        "places": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/place"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/transition"
          }
        },
        "arcs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/arc"
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/binding"
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/operation"
          }
        },
        "internal_ports": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/port"
          }
        },
        "internal_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/binding"
          }
        },
        "lease_identities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/lease_identity"
          }
        },
        "lease_pools": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/lease_pool"
          }
        },
        "variable_resource_arcs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/variable_resource_arc"
          }
        },
        "logical_slots": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/logical_slot"
          }
        },
        "reset_arcs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/reset_arc"
          }
        }
      }
    },
    "net": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "places",
        "transitions",
        "arcs",
        "operations",
        "port_places",
        "entry",
        "exit",
        "terminal",
        "required_schemas",
        "budgets",
        "designer_constraints",
        "analyzers",
        "lease_identities",
        "lease_pools",
        "variable_resource_arcs",
        "logical_slots",
        "budget_buckets",
        "terminal_alternatives",
        "reset_arcs"
      ],
      "properties": {
        "name": {
          "$ref": "#/definitions/symbol"
        },
        "places": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/place"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/transition"
          }
        },
        "arcs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/arc"
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/operation"
          }
        },
        "port_places": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/symbol"
          }
        },
        "entry": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/symbol"
          }
        },
        "exit": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/symbol"
          }
        },
        "terminal": {
          "$ref": "#/definitions/module/definitions/terminal"
        },
        "required_schemas": {
