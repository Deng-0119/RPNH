{
  "$id": "rpnh/environment_preparation_receipt/v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "action_results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "maxLength": 240,
            "minLength": 1,
            "type": "string"
          },
          "reason_code": {
            "maxLength": 240,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "completed",
              "failed",
              "cancelled",
              "not_started"
            ]
          }
        },
        "required": [
          "action_id",
          "status",
          "reason_code"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "minItems": 0,
      "type": "array"
    },
    "after_check_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "before_check_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "completed_at": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
    },
    "failure": {
      "anyOf": [
        {
          "maxLength": 240,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "host_declarations_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "result_binding_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "result_binding_revision": {
      "anyOf": [
        {
          "maxLength": 240,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": "rpnh/environment_preparation_receipt/v1"
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "entry_id": {
          "maxLength": 120,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "type": "string"
        },
        "package_lock_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "requirement_artifacts": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "artifact_digest": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "artifact_path": {
                "maxLength": 240,
                "minLength": 1,
                "type": "string"
              },
              "entry_id": {
                "maxLength": 120,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
                "type": "string"
              },
              "manifest_digest": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "manifest_digest",
              "entry_id",
              "artifact_path",
              "artifact_digest"
            ],
            "type": "object"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "requirements_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "root_archive_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "root_manifest_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "package_lock_digest",
        "root_manifest_digest",
        "root_archive_digest",
        "entry_id",
        "requirement_artifacts",
        "requirements_digest"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "target",
    "result_binding_revision",
    "result_binding_digest",
    "plan_digest",
    "before_check_digest",
    "action_results",
    "after_check_digest",
    "host_declarations_digest",
    "failure",
    "completed_at"
  ],
  "type": "object"
}
