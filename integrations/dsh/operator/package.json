{
  "name": "dsh-rpnh-operator",
  "version": "0.1.0-rc.3",
  "description": "RPNH adaptation for DSH: native existing-task tools and visible version identity",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "client.js",
    "updates.js",
    "transport.js",
    "cordis.patch.yml",
    "README.md",
    "README_ZH.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.6-alpha.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  }
}
